<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:InfinityMercsApp.Converters"
             x:Class="InfinityMercsApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Sizes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:RichTextConverter x:Key="RichText" />
            <converters:AlignmentConverter x:Key="Alignment" />
            <converters:InsetConverter x:Key="Inset" />
            <converters:HtmlSourceConverter x:Key="HtmlSource" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
