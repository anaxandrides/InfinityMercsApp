<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InfinityMercsApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:aboutViews="clr-namespace:InfinityMercsApp.Views.About"
    xmlns:feedbackViews="clr-namespace:InfinityMercsApp.Views.Feedback"
    xmlns:referenceViews="clr-namespace:InfinityMercsApp.Views.Reference"
    xmlns:settingsViews="clr-namespace:InfinityMercsApp.Views.Settings"
    xmlns:marketplacesViews="clr-namespace:InfinityMercsApp.Views.Marketplaces"
    xmlns:companyViews="clr-namespace:InfinityMercsApp.Views.Company"
    xmlns:armoryViews="clr-namespace:InfinityMercsApp.Views.Armory"
    xmlns:unitBrowserViews="clr-namespace:InfinityMercsApp.Views.UnitBrowser"
    xmlns:seasonViews="clr-namespace:InfinityMercsApp.Views.Season"
    xmlns:seasonOverviewViews="clr-namespace:InfinityMercsApp.Views.Season.Overview"
    Shell.FlyoutBehavior="Flyout"
    Title="InfinityMercsApp">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate seasonViews:MercsSeasonPage}"
        Route="MercsSeasonPage" />

    <ShellContent
        Title="Create New Company"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate companyViews:CreateNewCompanyPage}"
        Route="CreateNewCompanyPage" />

    <ShellContent
        Title="Standard Company"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate companyViews:StandardCompanySourcePopupPage}"
        Route="StandardCompanySourcePopupPage" />

    <ShellContent
        Title="Settings"
        ContentTemplate="{DataTemplate settingsViews:SettingsPage}"
        Route="SettingsPage" />

    <FlyoutItem
        Title="MERCS Reference"
        Route="MercsReference">
        <ShellContent
            Title="Mercs Glossary"
            ContentTemplate="{DataTemplate referenceViews:MercsGlossaryPage}"
            Route="MercsGlossaryPage" />
        <ShellContent
            Title="Perks Tables"
            ContentTemplate="{DataTemplate referenceViews:PerksTablesPage}"
            Route="PerksTablesPage" />
        <ShellContent
            Title="Armory"
            ContentTemplate="{DataTemplate armoryViews:ArmoryPage}"
            Route="ArmoryPage" />
        <ShellContent
            Title="Marketplaces"
            ContentTemplate="{DataTemplate marketplacesViews:MarketplacesPage}"
            Route="MarketplacesPage" />
        <ShellContent
            Title="Unit Encyclopedia"
            ContentTemplate="{DataTemplate unitBrowserViews:UnitEncyclopediaPage}"
            Route="UnitEncyclopediaPage" />
    </FlyoutItem>

    <ShellContent
        Title="About"
        ContentTemplate="{DataTemplate aboutViews:AboutPage}"
        Route="AboutPage" />

    <ShellContent
        Title="Season"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate seasonOverviewViews:SeasonPage}"
        Route="SeasonPage" />

    <!-- Choosing the company a new season plays, from the MERCS Season page; also where companies are deleted. -->
    <ShellContent
        Title="Load Company"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate companyViews:LoadCompanyPage}"
        Route="LoadCompanyPage" />

    <!-- <ShellContent
        Title="Feedback/Bugs"
        ContentTemplate="{DataTemplate feedbackViews:FeedbackBugsPage}"
        Route="FeedbackBugsPage" /> -->


</Shell>
