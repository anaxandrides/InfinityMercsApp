<?xml version="1.0" encoding="utf-8" ?>
<layout:AdaptiveContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:companyViewModels="clr-namespace:InfinityMercsApp.ViewModels.Company"
    xmlns:layout="clr-namespace:InfinityMercsApp.Views.Adaptive"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="InfinityMercsApp.Views.StandardCompanySourcePopupPage"
    x:Name="SourcePopupRoot"
    x:DataType="companyViewModels:StandardCompanySourcePopupPageViewModel"
    BackgroundColor="#800E1116"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <!-- Behaviors sit outside the visual tree, so the ViewModel is handed over explicitly. -->
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference SourcePopupRoot}, x:DataType=ContentPage}"
                                        x:DataType="companyViewModels:StandardCompanySourcePopupPageViewModel"
                                        EventName="LayoutModeChanged"
                                        Command="{Binding ApplyLayoutCommand}"
                                        CommandParameter="{Binding LayoutMode, Source={x:Reference SourcePopupRoot}, x:DataType=layout:AdaptiveContentPage}" />
    </ContentPage.Behaviors>

    <Grid Padding="32">
        <Border
            HorizontalOptions="{Binding Layout.ModalHorizontalOptions}"
            VerticalOptions="{Binding Layout.ModalVerticalOptions}"
            MaximumWidthRequest="{Binding Layout.ModalMaximumWidth}"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
            StrokeThickness="0"
            Padding="24"
            StrokeShape="RoundRectangle 4">
            <Grid RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label
                    Text="Choose your source of units:"
                    FontSize="{DynamicResource FontSizeTitleLarge}"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <ScrollView Grid.Row="1">
                <Grid layout:GridLayout.Columns="{Binding Layout.CardsColumns}"
                      layout:GridLayout.Rows="{Binding Layout.CardsRows}"
                      ColumnSpacing="{Binding Layout.CardsColumnSpacing}"
                      RowSpacing="{Binding Layout.CardsRowSpacing}">

                    <Grid MinimumHeightRequest="{Binding Layout.CardMinimumHeight}">
                        <Button Text="" Command="{Binding VanillaFactionSelectedCommand}" />
                        <VerticalStackLayout InputTransparent="True" Spacing="12" Padding="12">
                            <Image
                                HeightRequest="{Binding Layout.IconHeight}"
                                HorizontalOptions="Fill"
                                Source="single_sectorial.png" />
                            <Label
                                Text="One Vanilla Faction"
                                FontSize="{DynamicResource FontSizeTitleLarge}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid layout:GridLayout.Cell="{Binding Layout.SecondCardCell}" MinimumHeightRequest="{Binding Layout.CardMinimumHeight}">
                        <Button Text="" Command="{Binding TwoSectorialsSelectedCommand}" />
                        <VerticalStackLayout InputTransparent="True" Spacing="12" Padding="12">
                            <Image
                                HeightRequest="{Binding Layout.IconHeight}"
                                HorizontalOptions="Fill"
                                Source="multiple_sectorials.png" />
                            <Label
                                Text="Two Sectorials"
                                FontSize="{DynamicResource FontSizeTitleLarge}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
                </ScrollView>

                <Button
                    Grid.Row="2"
                    Text="← BACK"
                    HorizontalOptions="Start"
                    Command="{Binding ClosePopupCommand}" />
            </Grid>
        </Border>
    </Grid>
</layout:AdaptiveContentPage>
