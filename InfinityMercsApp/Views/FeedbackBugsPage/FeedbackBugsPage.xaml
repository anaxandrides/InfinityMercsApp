<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:InfinityMercsApp.Views"
             xmlns:viewModels="clr-namespace:InfinityMercsApp.ViewModels"
             x:Class="InfinityMercsApp.Views.FeedbackBugsPage"
             x:DataType="viewModels:FeedbackBugsPageViewModel"
             Title="Feedback/Bugs">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label
                Text="Feedback/Bugs"
                FontAttributes="Bold"
                FontSize="{DynamicResource FontSizeTitleLarge}" />

            <Label
                Text="This page automatically emails feedback/bug details to jeremiahpatrick@protonmail.com."
                LineBreakMode="WordWrap" />

            <BoxView HeightRequest="1" Opacity="0.4" />

            <Label Text="Your Email" FontAttributes="Bold" />
            <Entry Text="{Binding UserEmail}"
                   Keyboard="Email"
                   Placeholder="you@example.com" />

            <Label Text="Category" FontAttributes="Bold" />
            <Picker Title="Select category"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}" />

            <Label Text="Title" FontAttributes="Bold" />
            <Entry Text="{Binding TicketTitle}" Placeholder="Short summary" />

            <Label Text="Description" FontAttributes="Bold" />
            <Editor Text="{Binding Description}"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="180"
                    Placeholder="Describe the issue or feedback." />

            <Button Text="Submit Ticket"
                    Command="{Binding SubmitCommand}" />

            <ActivityIndicator IsVisible="{Binding IsSubmitting}"
                               IsRunning="{Binding IsSubmitting}" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="LightGreen"
                   LineBreakMode="WordWrap">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsStatusError}" Value="True">
                        <Setter Property="TextColor" Value="OrangeRed" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>

</views:ContentPageBase>
