<?xml version="1.0" encoding="utf-8" ?>
<baseViews:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:baseViews="clr-namespace:InfinityMercsApp.Views.Base"
             xmlns:viewModels="clr-namespace:InfinityMercsApp.ViewModels"
             x:Class="InfinityMercsApp.Views.SplashPage"
             x:DataType="viewModels:SplashPageViewModel"
             BackgroundColor="#0E1116">

    <Grid>
        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="16">

            <Image Source="m2_no_bg_short.webp"
                HeightRequest="120"
                WidthRequest="320"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                Text="Infinity Mercs"
                FontSize="{DynamicResource FontSizeTitleLarge}"
                FontAttributes="Bold"
                TextColor="#E6EBF2"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                IsRunning="True"
                Color="#34D399"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                Text="{Binding UpdateProgressMessage}"
                FontSize="{DynamicResource FontSizeSectionHeader}"
                TextColor="#8A97A8"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>

</baseViews:ContentPageBase>

