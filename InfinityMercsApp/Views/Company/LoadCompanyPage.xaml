<?xml version="1.0" encoding="utf-8" ?>
<layout:AdaptiveContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:InfinityMercsApp.Views.Company"
             xmlns:records="clr-namespace:InfinityMercsApp.Services.Records;assembly=InfinityMercsApp.Services"
             xmlns:companyViewModels="clr-namespace:InfinityMercsApp.ViewModels.Company"
             xmlns:layout="clr-namespace:InfinityMercsApp.Views.Adaptive"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             x:Class="InfinityMercsApp.Views.Company.LoadCompanyPage"
             x:Name="Root"
             x:DataType="companyViewModels:LoadCompanyViewModel"
             Title="Load Company">

    <ContentPage.Behaviors>
        <!-- Behaviors sit outside the visual tree, so the ViewModel is handed over explicitly. -->
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Root}, x:DataType=ContentPage}"
                                        x:DataType="companyViewModels:LoadCompanyViewModel"
                                        EventName="LayoutModeChanged"
                                        Command="{Binding ApplyLayoutCommand}"
                                        CommandParameter="{Binding LayoutMode, Source={x:Reference Root}, x:DataType=layout:AdaptiveContentPage}" />
    </ContentPage.Behaviors>

    <Grid Padding="16"
          RowDefinitions="Auto,*"
          RowSpacing="12"
          MaximumWidthRequest="{Binding Layout.MaximumWidth}"
          HorizontalOptions="{Binding Layout.HorizontalOptions}">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label
                Text="Load Records"
                FontSize="{DynamicResource FontSizeDisplay}"
                FontAttributes="Bold"
                HorizontalTextAlignment="Start" />
            <Label
                Text="All saved armies are listed below."
                HorizontalTextAlignment="Start" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <CollectionView
                ItemsSource="{Binding SavedRecords}"
                SelectionMode="None"
                IsVisible="{Binding HasSavedRecords}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{Binding Layout.Columns}" HorizontalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="records:CompanyRecord">
                        <Border StrokeThickness="1" Padding="10" Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewModel.OpenCompanyCommand, Source={x:Reference Root}, x:DataType=view:LoadCompanyPage}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <controls:SvgIcon
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        VerticalOptions="Center"
                                        Source="{Binding CompanyIconPath}" />
                                    <!-- One faction logo fills the square; a second shares it side by side. -->
                                    <Grid WidthRequest="50" HeightRequest="50" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <controls:SvgIcon Source="{Binding PrimaryFactionIconPath}" />
                                        <controls:SvgIcon
                                            Grid.Column="1"
                                            WidthRequest="23"
                                            Margin="4,0,0,0"
                                            IsVisible="{Binding HasSecondaryFactionIcon}"
                                            Source="{Binding SecondaryFactionIconPath}" />
                                    </Grid>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label
                                        Text="{Binding CompanyName}"
                                        FontSize="{DynamicResource FontSizeSubHeadline}"
                                        FontAttributes="Bold" />
                                    <Label
                                        Text="{Binding Subtitle}"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="2"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    StrokeThickness="0"
                                    Padding="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewModel.DeleteCompanyCommand, Source={x:Reference Root}, x:DataType=view:LoadCompanyPage}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <controls:SvgIcon
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        Source="SVGCache/NonCBIcons/noun-trash-1523235.svg" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Text="No saved armies found."
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                IsVisible="{Binding HasSavedRecords, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>
    </Grid>

</layout:AdaptiveContentPage>
