<?xml version="1.0" encoding="utf-8" ?>
<baseViews:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:baseViews="clr-namespace:InfinityMercsApp.Views.Base"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:InfinityMercsApp.ViewModels.Settings"
             x:Class="InfinityMercsApp.Views.Settings.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">

    <Grid>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Show Units in:"
                    FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="16">
                    <RadioButton
                        Content="Inches"
                        GroupName="GlobalDisplayUnits"
                        IsChecked="{Binding ShowUnitsInInches}" />
                    <RadioButton
                        Content="Centimeters"
                        GroupName="GlobalDisplayUnits"
                        IsChecked="{Binding ShowUnitsInCentimeters}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Switch IsToggled="{Binding SendDiagnostics}" VerticalOptions="Center" />
                    <Label
                        Text="Send anonymous diagnostics"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label
                    Text="Pages shown, crashes, timings and sync failures, to help fix problems. Never your companies, names or account."
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Button
                Text="Check for army data updates"
                Command="{Binding UpdateAllDataCommand}"
                HorizontalOptions="Fill" />

            <Label
                Text="{Binding UpdateStatus}"
                LineBreakMode="WordWrap" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding CanSignInHere}">
                <Label
                    Text="Account:"
                    FontAttributes="Bold" />
                <Label
                    Text="{Binding AccountText}"
                    LineBreakMode="WordWrap" />
                <Button
                    Text="Sign in"
                    Command="{Binding SignInCommand}"
                    IsVisible="{Binding ShowSignIn}"
                    HorizontalOptions="Fill" />
                <Button
                    Text="Sync now"
                    Command="{Binding SyncNowCommand}"
                    IsVisible="{Binding ShowSignOut}"
                    HorizontalOptions="Fill" />
                <Label
                    Text="{Binding SyncStatus}"
                    LineBreakMode="WordWrap" />
                <Button
                    Text="Sign out"
                    Command="{Binding SignOutCommand}"
                    IsVisible="{Binding ShowSignOut}"
                    HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid
            IsVisible="{Binding IsUpdateInProgress}"
            InputTransparent="False"
            BackgroundColor="#80000000">
            <Border
                Padding="16"
                StrokeThickness="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MinimumWidthRequest="280">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Checking Army Data"
                        FontAttributes="Bold"
                        FontSize="{DynamicResource FontSizeSubHeadline}"
                        HorizontalTextAlignment="Center" />
                    <ActivityIndicator IsRunning="True" HorizontalOptions="Center" />
                    <Label
                        Text="{Binding UpdateProgressMessage}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</baseViews:ContentPageBase>

