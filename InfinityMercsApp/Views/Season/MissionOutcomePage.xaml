<?xml version="1.0" encoding="utf-8" ?>
<baseViews:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:seasonViewModels="clr-namespace:InfinityMercsApp.ViewModels.Season"
             xmlns:baseViews="clr-namespace:InfinityMercsApp.Views.Base"
             x:Class="InfinityMercsApp.Views.Season.MissionOutcomePage"
             x:DataType="seasonViewModels:MissionOutcomeViewModel"
             Title="Mission Outcome"
             BackgroundColor="{StaticResource Void}">

    <ContentPage.Resources>
        <Style x:Key="ResultButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource HairlineBright}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="RowValue" TargetType="Label">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
        </Style>
        <Style x:Key="Rule" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Color" Value="{StaticResource HairlineBright}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12,16,16">

        <Label Grid.Row="0"
               Text="MISSION OUTCOME"
               FontSize="{DynamicResource FontSizeTitleSmall}"
               FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}"
               Margin="0,0,0,12"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <!-- Victory / Defeat selection -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mission Result"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontAttributes="Bold" />
                    <Grid ColumnSpacing="8" ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Text="VICTORY"
                                Style="{StaticResource ResultButton}"
                                TextColor="{StaticResource Signal}"
                                Command="{Binding SelectVictoryCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsVictory}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#2A6B57" />
                                    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Text="DEFEAT"
                                Style="{StaticResource ResultButton}"
                                TextColor="{StaticResource Danger}"
                                Command="{Binding SelectDefeatCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsDefeat}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#7F1D1D" />
                                    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

                <!-- Points scored -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Points Scored"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontAttributes="Bold" />
                    <Picker Title="Select points (0-10)..."
                            ItemsSource="{Binding PointOptions}"
                            SelectedItem="{Binding PointsScored}"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextMuted}"
                            BackgroundColor="{StaticResource HairlineBright}" />
                </VerticalStackLayout>

                <!-- Outcome breakdown card -->
                <Border Stroke="Transparent"
                        BackgroundColor="{StaticResource Plate}"
                        StrokeShape="RoundRectangle 4"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Round Number" Style="{StaticResource RowLabel}" />
                            <Label Text="{Binding RoundNumber}" Style="{StaticResource RowValue}" />
                        </Grid>
                        <BoxView Style="{StaticResource Rule}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Mission Credits" Style="{StaticResource RowLabel}" />
                            <Label Text="{Binding MissionCredits}" Style="{StaticResource RowValue}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Objectives Secured" Style="{StaticResource RowLabel}" />
                            <Label Text="{Binding ObjectiveCredits}" Style="{StaticResource RowValue}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsVictory}">
                            <Label Text="Victory" Style="{StaticResource RowLabel}" />
                            <Label Text="{Binding VictoryCredits}" Style="{StaticResource RowValue}" />
                        </Grid>
                        <BoxView Style="{StaticResource Rule}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="SUM" Style="{StaticResource RowLabel}" />
                            <Label Text="{Binding CreditsTotal}" Style="{StaticResource RowValue}" FontAttributes="Bold" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="SWC" Style="{StaticResource RowLabel}" />
                            <Label Text="{Binding SwcText}" Style="{StaticResource RowValue}" FontAttributes="Bold" TextColor="#F59E0B" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                Text="GO TO EXPERIENCE"
                BackgroundColor="{StaticResource Signal}"
                TextColor="{StaticResource Void}"
                FontAttributes="Bold"
                Margin="0,12,0,0"
                Command="{Binding GoToExperienceCommand}"
                HorizontalOptions="Fill">
            <Button.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Button.Triggers>
        </Button>
    </Grid>
</baseViews:ContentPageBase>
