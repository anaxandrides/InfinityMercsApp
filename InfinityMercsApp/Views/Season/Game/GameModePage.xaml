<?xml version="1.0" encoding="utf-8" ?>
<baseViews:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:InfinityMercsApp.Views.Season.Game"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:game="clr-namespace:InfinityMercsApp.ViewModels.Season.Game"
             xmlns:gameItems="clr-namespace:InfinityMercsApp.ViewModels.Season.Game.Items"
             xmlns:gameRules="clr-namespace:InfinityMercsApp.Domain.Season.Game;assembly=InfinityMercsApp.Domain"
             xmlns:stats="clr-namespace:InfinityMercsApp.Domain.Models.Army.Stats;assembly=InfinityMercsApp.Domain"
             xmlns:baseViews="clr-namespace:InfinityMercsApp.Views.Base"
             x:Class="InfinityMercsApp.Views.Season.Game.GameModePage"
             x:Name="GameModePageRoot"
             x:DataType="game:GameModeViewModel"
             Title="CONTRACT IN PROGRESS"
             BackgroundColor="{StaticResource Void}">

    <ContentPage.Resources>
        <Style x:Key="OrderCount" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubHeadline}" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="#3A4554" />
            <Setter Property="TextColor" Value="#E6EBF2" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#161B22" />
            <Setter Property="Stroke" Value="#3A4554" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        </Style>
        <Style x:Key="WeaponCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#0E1116" />
            <Setter Property="Stroke" Value="#3A4554" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="XpSection" TargetType="Label">
            <Setter Property="TextColor" Value="#B5C0CE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="XpLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#8A97A8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="Divider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Color" Value="#3A4554" />
            <Setter Property="Margin" Value="0,7,0,4" />
        </Style>
        <Style x:Key="DoneButton" TargetType="Button">
            <Setter Property="Text" Value="Done" />
            <Setter Property="BackgroundColor" Value="#34D399" />
            <Setter Property="TextColor" Value="#E6EBF2" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="36" />
        </Style>

        <!-- A single XP checkbox with its label. -->
        <DataTemplate x:Key="XpCheckTemplate" x:DataType="gameItems:XpCheck">
            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center" FlexLayout.Grow="1" FlexLayout.Basis="0">
                <CheckBox Color="#34D399" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" />
                <Label Text="{Binding Label}" Style="{StaticResource XpLabel}" />
            </HorizontalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0">

        <!-- Round header band -->
        <Border BackgroundColor="{StaticResource Plate}"
                Stroke="{StaticResource Hairline}"
                StrokeThickness="1"
                Padding="8,6"
                StrokeShape="Rectangle">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Button Text="END"
                        BackgroundColor="{StaticResource Danger}"
                        BorderColor="{StaticResource Danger}"
                        BorderWidth="2"
                        TextColor="{StaticResource TextPrimary}"
                        FontAttributes="Bold"
                        FontSize="{DynamicResource FontSizeBody}"
                        HeightRequest="36"
                        WidthRequest="60"
                        Padding="4,0"
                        CornerRadius="4"
                        IsVisible="{Binding CanEndGame}"
                        Command="{Binding EndGameCommand}" />
                <Label Grid.Column="1"
                       Text="{Binding RoundText}"
                       FontSize="{DynamicResource FontSizeSubHeadline}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Signal}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                <Button Grid.Column="2"
                        Text="❯"
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        BorderWidth="0"
                        TextColor="{StaticResource Signal}"
                        FontSize="{DynamicResource FontSizeTitleSmall}"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        WidthRequest="44"
                        Padding="0"
                        IsVisible="{Binding HasNextRound}"
                        Command="{Binding NextRoundCommand}" />
            </Grid>
        </Border>

        <!-- Orders left this round; tap one to spend it. -->
        <FlexLayout Grid.Row="1" Padding="8,12,8,4" BindableLayout.ItemsSource="{Binding Orders}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="gameItems:OrderPoolItem">
                    <HorizontalStackLayout FlexLayout.Grow="1" FlexLayout.Basis="0" HorizontalOptions="Center" Spacing="4">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <controls:SvgIcon Source="{Binding IconPath}" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" />
                        <Label Text="{Binding Available}" TextColor="{StaticResource Signal}" Style="{StaticResource OrderCount}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="{x:Static gameRules:OrderKind.Lieutenant}">
                                    <Setter Property="TextColor" Value="#FBBF24" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="{x:Static gameRules:OrderKind.Impetuous}">
                                    <Setter Property="TextColor" Value="#F97316" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="{x:Static gameRules:OrderKind.Irregular}">
                                    <Setter Property="TextColor" Value="{StaticResource Caution}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <!-- Orders spent; tap one to take it back. -->
        <FlexLayout Grid.Row="2" Padding="8,4,8,8" BindableLayout.ItemsSource="{Binding Orders}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="gameItems:OrderPoolItem">
                    <HorizontalStackLayout FlexLayout.Grow="1" FlexLayout.Basis="0" HorizontalOptions="Center" Spacing="4">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RestoreCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <controls:SvgIcon Source="{Binding IconPath}" IsGreyscale="True" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" />
                        <Label Text="{Binding Used}" TextColor="{StaticResource TextMuted}" Style="{StaticResource OrderCount}" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <!-- Unit accordion: one row open at a time. -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="0" Padding="0,8,0,0" BindableLayout.ItemsSource="{Binding Units}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="gameItems:GameUnitItem">
                        <VerticalStackLayout Spacing="0">
                            <Grid MinimumHeightRequest="48" Padding="16,8" ColumnSpacing="4" ColumnDefinitions="24,*,Auto,32">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewModel.ToggleUnitCommand, Source={x:Reference GameModePageRoot}, x:DataType=view:GameModePage}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Text="▶"
                                       TextColor="#8A97A8"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       WidthRequest="20"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="▼" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       TextColor="#E6EBF2"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="TailTruncation" />
                                <controls:SvgIcon Grid.Column="2"
                                                  Source="SVGCache/CBIcons/tactical.svg"
                                                  IsGreyscale="{Binding IsTacticalTokenSpent}"
                                                  IsVisible="{Binding HasTacticalToken}"
                                                  WidthRequest="32"
                                                  HeightRequest="32"
                                                  VerticalOptions="Center">
                                    <controls:SvgIcon.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleTacticalTokenCommand}" />
                                    </controls:SvgIcon.GestureRecognizers>
                                </controls:SvgIcon>
                                <Grid Grid.Column="3" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                    <controls:SvgIcon Source="{Binding WoundIconPath}" />
                                    <Label Text="2"
                                           IsVisible="{Binding IsOnSecondBody}"
                                           TextColor="#E6EBF2"
                                           FontSize="{DynamicResource FontSizeMicro}"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="End" />
                                </Grid>
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="16,4,16,12" Spacing="8" BackgroundColor="#161B22">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,0,0,4">
                                    <Button Text="Take Wound" Style="{StaticResource RowButton}" Command="{Binding TakeWoundCommand}" />
                                    <Button Grid.Column="1" Text="Heal Wound" Style="{StaticResource RowButton}" Command="{Binding HealWoundCommand}" />
                                    <Button Grid.Column="2"
                                            Text="{Binding XpButtonText}"
                                            Style="{StaticResource RowButton}"
                                            TextColor="#34D399"
                                            Command="{Binding ViewModel.ShowXpCommand, Source={x:Reference GameModePageRoot}, x:DataType=view:GameModePage}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <FlexLayout BindableLayout.ItemsSource="{Binding Statline}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="stats:StatValue">
                                            <VerticalStackLayout FlexLayout.Grow="1" FlexLayout.Basis="0" Spacing="2">
                                                <Label Text="{Binding Key}" FontSize="{DynamicResource FontSizeMicro}" TextColor="#8A97A8" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Value}" FontSize="{DynamicResource FontSizeBody}" TextColor="#E6EBF2" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding EquipmentItems}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label FlexLayout.Basis="50%" Text="{Binding .}" TextColor="#B5C0CE" FontSize="{DynamicResource FontSizeCaption}" LineBreakMode="WordWrap" Margin="0,0,8,2" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SkillItems}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label FlexLayout.Basis="50%" Text="{Binding .}" TextColor="#F59E0B" FontSize="{DynamicResource FontSizeCaption}" LineBreakMode="WordWrap" Margin="0,0,8,2" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <!-- Weapon cards; tap one for every mode in full. -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeaponCards}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="gameItems:GameWeaponCard">
                                            <Border Style="{StaticResource WeaponCard}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ViewModel.ShowWeaponCommand, Source={x:Reference GameModePageRoot}, x:DataType=view:GameModePage}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="0">
                                                    <Label Text="{Binding Title}"
                                                           TextColor="#E6EBF2"
                                                           FontSize="{DynamicResource FontSizeCardTitleCompact}"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center"
                                                           Margin="0,0,0,6">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsMatched}" Value="False">
                                                                <Setter Property="FontSize" Value="13" />
                                                                <Setter Property="HorizontalTextAlignment" Value="Start" />
                                                                <Setter Property="Margin" Value="0" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Modes}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="gameItems:GameWeaponMode">
                                                                <VerticalStackLayout Spacing="0">
                                                                    <BoxView HeightRequest="1"
                                                                             Color="#3A4554"
                                                                             Margin="0,5,0,5"
                                                                             IsVisible="{Binding IsFirst, Converter={StaticResource InvertedBoolConverter}}" />
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <Label Text="{Binding Label}"
                                                                               Style="{StaticResource LabelCaption}"
                                                                               TextColor="#E6EBF2"
                                                                               FontAttributes="Bold"
                                                                               VerticalTextAlignment="Center"
                                                                               LineBreakMode="TailTruncation" />
                                                                        <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                                            <Border Style="{StaticResource Chip}" IsVisible="{Binding HasBurst}">
                                                                                <HorizontalStackLayout Spacing="3">
                                                                                    <Label Text="B" Style="{StaticResource LabelCaption}" TextColor="#8A97A8" />
                                                                                    <Label Text="{Binding Burst}" Style="{StaticResource LabelCaption}" FontAttributes="Bold" TextColor="#E6EBF2" />
                                                                                </HorizontalStackLayout>
                                                                            </Border>
                                                                            <Border Style="{StaticResource Chip}" IsVisible="{Binding HasDamage}">
                                                                                <HorizontalStackLayout Spacing="3">
                                                                                    <Label Text="DAM" Style="{StaticResource LabelCaption}" TextColor="#8A97A8" />
                                                                                    <Label Text="{Binding Damage}" Style="{StaticResource LabelCaption}" FontAttributes="Bold" TextColor="#E6EBF2" />
                                                                                </HorizontalStackLayout>
                                                                            </Border>
                                                                            <Border Style="{StaticResource Chip}" Stroke="#F59E0B" Padding="6,1" StrokeShape="RoundRectangle 8" IsVisible="{Binding HasAmmo}">
                                                                                <Label Text="{Binding Ammo}" Style="{StaticResource LabelCaption}" FontAttributes="Bold" TextColor="#F59E0B" />
                                                                            </Border>
                                                                            <Label Text="›" TextColor="#8A97A8" FontSize="{DynamicResource FontSizeSectionHeader}" VerticalTextAlignment="Center" />
                                                                        </HorizontalStackLayout>
                                                                    </Grid>
                                                                </VerticalStackLayout>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <controls:WeaponRangeBandBarView Distance="{Binding Range}"
                                                                                     IsVisible="{Binding HasRange}"
                                                                                     ShowUnitsInInches="{Binding ViewModel.ShowUnitsInInches, Source={x:Reference GameModePageRoot}, x:DataType=view:GameModePage}"
                                                                                     BarHeightRequest="44"
                                                                                     XVisorActive="{Binding HasXVisor}"
                                                                                     Margin="0,6,0,0"
                                                                                     HorizontalOptions="Fill" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#3A4554" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Every mode of the tapped weapon in full. -->
        <ScrollView Grid.RowSpan="4" BackgroundColor="#161B22" IsVisible="{Binding IsShowingWeapon}">
            <VerticalStackLayout Padding="12,8" Spacing="8">
                <Label Text="{Binding OpenWeaponCard.Title, FallbackValue=''}"
                       TextColor="#E6EBF2"
                       FontAttributes="Bold"
                       FontSize="{DynamicResource FontSizeSectionHeader}"
                       HorizontalTextAlignment="Center" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding OpenWeaponCard.Modes, FallbackValue={x:Null}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="gameItems:GameWeaponMode">
                            <controls:WeaponDetailCardView Weapon="{Binding Weapon}"
                                                           AmmoType="{Binding Ammo}"
                                                           RangeBandHeightRequest="88"
                                                           DamageReduction="{Binding Modifiers.DamageReduction}"
                                                           BurstBonus="{Binding Modifiers.BurstBonus}"
                                                           ShowUnitsInInches="{Binding ViewModel.ShowUnitsInInches, Source={x:Reference GameModePageRoot}, x:DataType=view:GameModePage}"
                                                           XVisorActive="{Binding ViewModel.OpenWeaponCard.HasXVisor, Source={x:Reference GameModePageRoot}, x:DataType=view:GameModePage, FallbackValue=False}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Style="{StaticResource DoneButton}" Margin="0,4,0,0" Command="{Binding CloseWeaponCommand}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- The tapped trooper's XP sheet. -->
        <ScrollView Grid.RowSpan="4" BackgroundColor="#161B22" IsVisible="{Binding IsShowingXp}">
            <VerticalStackLayout Padding="12,6" Spacing="0" BindingContext="{Binding OpenXpSheet}" x:DataType="gameItems:XpSheet">
                <Label Text="{Binding UnitName}" TextColor="#E6EBF2" FontAttributes="Bold" FontSize="{DynamicResource FontSizeCardTitleCompact}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding TotalText}" TextColor="#34D399" FontSize="{DynamicResource FontSizeCaption}" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,2,0,0" />

                <BoxView Style="{StaticResource Divider}" />
                <Label Style="{StaticResource XpSection}" Text="Assisting an allied unit&#10;(engineering / doctoring / medikit / gizmokit / casevac)" />
                <FlexLayout Margin="0,2,0,0" BindableLayout.ItemsSource="{Binding Assist}" BindableLayout.ItemTemplate="{StaticResource XpCheckTemplate}" />

                <BoxView Style="{StaticResource Divider}" />
                <Label Style="{StaticResource XpSection}" Text="Inflicting 1+ state(s) (stunned / spotlit / immobilized / isolated) in one order" />
                <FlexLayout Margin="0,2,0,0" BindableLayout.ItemsSource="{Binding InflictState}" BindableLayout.ItemTemplate="{StaticResource XpCheckTemplate}" />

                <BoxView Style="{StaticResource Divider}" />
                <Label Style="{StaticResource XpSection}" Text="Making a roll to accomplish an objective that is NOT attacking the opponent" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4" Margin="0,2,0,0">
                    <HorizontalStackLayout Spacing="4">
                        <CheckBox Color="#34D399" IsChecked="{Binding Attempted.IsChecked}" IsEnabled="{Binding Attempted.IsEnabled}" />
                        <Label Text="{Binding Attempted.Label}" Style="{StaticResource XpLabel}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                        <CheckBox Color="#34D399" IsChecked="{Binding Succeeded.IsChecked}" />
                        <Label Text="{Binding Succeeded.Label}" Style="{StaticResource XpLabel}" />
                    </HorizontalStackLayout>
                </Grid>

                <BoxView Style="{StaticResource Divider}" />
                <Label Style="{StaticResource XpSection}" Text="Scanning an enemy (the Scan skill): with LoF, marking an unconscious, immobilized or Shasvastii-state enemy, which becomes Targeted. A Forward Observer earns 1 more XP." />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4" Margin="0,2,0,0">
                    <HorizontalStackLayout Spacing="4">
                        <CheckBox Color="#34D399" IsChecked="{Binding Scanned.IsChecked}" IsEnabled="{Binding Scanned.IsEnabled}" />
                        <Label Text="{Binding Scanned.Label}" Style="{StaticResource XpLabel}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                        <CheckBox Color="#34D399" IsChecked="{Binding ScannedWithFo.IsChecked}" />
                        <Label Text="{Binding ScannedWithFo.Label}" Style="{StaticResource XpLabel}" />
                    </HorizontalStackLayout>
                </Grid>

                <BoxView Style="{StaticResource Divider}" />
                <Label Style="{StaticResource XpSection}" Text="Tag and Bag [Mercs Skill]" />
                <HorizontalStackLayout Spacing="4" Margin="0,2,0,0">
                    <CheckBox Color="#34D399" IsChecked="{Binding TagAndBag.IsChecked}" />
                    <Label Text="{Binding TagAndBag.Label}" Style="{StaticResource XpLabel}" />
                </HorizontalStackLayout>

                <BoxView Style="{StaticResource Divider}" Margin="0,8,0,4" />
                <Button Style="{StaticResource DoneButton}"
                        Command="{Binding ViewModel.CloseXpCommand, Source={x:Reference GameModePageRoot}, x:DataType=view:GameModePage}" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</baseViews:ContentPageBase>
