<?xml version="1.0" encoding="utf-8" ?>
<layout:AdaptiveContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:seasonViewModels="clr-namespace:InfinityMercsApp.ViewModels.Season"
             xmlns:layout="clr-namespace:InfinityMercsApp.Views.Adaptive"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:season="clr-namespace:InfinityMercsApp.Services.Season;assembly=InfinityMercsApp.Services"
             x:Class="InfinityMercsApp.Views.Season.LoadSeasonPage"
             x:Name="Root"
             x:DataType="seasonViewModels:LoadSeasonViewModel"
             Title="Load Season"
             BackgroundColor="{StaticResource Void}">

    <ContentPage.Behaviors>
        <!-- Behaviors sit outside the visual tree, so the ViewModel is handed over explicitly. -->
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Root}, x:DataType=ContentPage}"
                                        x:DataType="seasonViewModels:LoadSeasonViewModel"
                                        EventName="LayoutModeChanged"
                                        Command="{Binding ApplyLayoutCommand}"
                                        CommandParameter="{Binding LayoutMode, Source={x:Reference Root}, x:DataType=layout:AdaptiveContentPage}" />
    </ContentPage.Behaviors>

    <Grid Padding="16"
          RowDefinitions="Auto,*"
          RowSpacing="12"
          MaximumWidthRequest="{Binding Layout.MaximumWidth}"
          HorizontalOptions="{Binding Layout.HorizontalOptions}">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Load Season"
                   FontSize="{DynamicResource FontSizeDisplay}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalTextAlignment="Start" />
            <Label Text="All saved seasons are listed below."
                   FontSize="{DynamicResource FontSizeBody}"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Start" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">

            <CollectionView ItemsSource="{Binding SeasonRecords}"
                            SelectionMode="None"
                            IsVisible="{Binding HasSeasonRecords}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{Binding Layout.Columns}" HorizontalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="season:SeasonRecord">
                        <Border StrokeThickness="1"
                                Stroke="{StaticResource Hairline}"
                                BackgroundColor="{StaticResource Plate}"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{DynamicResource CornerRadiusDefault}" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSeasonCommand, Source={RelativeSource AncestorType={x:Type seasonViewModels:LoadSeasonViewModel}}, x:DataType=seasonViewModels:LoadSeasonViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding CompanyName}"
                                       FontSize="{DynamicResource FontSizeSubHeadline}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Subtitle}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border IsVisible="{Binding HasSeasonRecords, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Plate}"
                    Stroke="{StaticResource Hairline}"
                    StrokeThickness="1"
                    Padding="{DynamicResource PaddingSection}"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{DynamicResource CornerRadiusDefault}" />
                </Border.StrokeShape>
                <Label Text="No saved seasons yet. Start a new season to begin your campaign."
                       FontSize="{DynamicResource FontSizeBody}"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center" />
            </Border>

        </Grid>

    </Grid>

</layout:AdaptiveContentPage>
