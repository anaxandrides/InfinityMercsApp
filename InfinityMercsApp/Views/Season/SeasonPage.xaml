<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:InfinityMercsApp.Views.Behaviors"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:marketplaces="clr-namespace:InfinityMercsApp.ViewModels.Marketplaces"
             xmlns:overview="clr-namespace:InfinityMercsApp.ViewModels.Season.Overview"
             xmlns:rankUp="clr-namespace:InfinityMercsApp.ViewModels.Season.RankUp"
             xmlns:viewer="clr-namespace:InfinityMercsApp.ViewModels.Company.Viewer"
             xmlns:views="clr-namespace:InfinityMercsApp.Views"
             x:Class="InfinityMercsApp.Views.Season.SeasonPage"
             x:Name="Root"
             x:DataType="overview:SeasonViewModel"
             Title=""
             BackgroundColor="{StaticResource Void}">

    <ContentPage.Behaviors>
        <behaviors:ResponsiveFontScaleBehavior />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Style x:Key="SectionHeading" TargetType="Label">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSectionHeader}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="SectionRule" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Color" Value="{StaticResource Hairline}" />
            <Setter Property="Margin" Value="0,1,0,3" />
        </Style>
        <Style x:Key="ListHeading" TargetType="Label" BasedOn="{StaticResource LabelCaption}">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="SlotHeading" TargetType="Label">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        </Style>
        <Style x:Key="QuantityButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource HairlineBright}" />
            <Setter Property="BorderColor" Value="{StaticResource HairlineBright}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubHeadline}" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        </Style>
        <Style x:Key="OverlayPanel" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Void}" />
            <Setter Property="Stroke" Value="{StaticResource Hairline}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="OverlayPicker" TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="TitleColor" Value="{StaticResource TextMuted}" />
            <Setter Property="BackgroundColor" Value="{StaticResource Hairline}" />
        </Style>

        <Style x:Key="ProfileLineLabel" TargetType="Label" BasedOn="{StaticResource LabelBody}">
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <!-- Equipment and skills lines; "(none)" is muted. -->
        <DataTemplate x:Key="EquipmentLine" x:DataType="overview:ProfileLine">
            <Label Text="{Binding Text}" Style="{StaticResource ProfileLineLabel}" TextColor="{StaticResource TextSecondary}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </DataTemplate>
        <!-- A skill. -->
        <DataTemplate x:Key="SkillLine" x:DataType="overview:ProfileLine">
            <Label Text="{Binding Text}" Style="{StaticResource ProfileLineLabel}" TextColor="{StaticResource Caution}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </DataTemplate>
        <!-- Weapons; tapping one shows its profiles. -->
        <DataTemplate x:Key="RangedLine" x:DataType="overview:ProfileLine">
            <Label Text="{Binding Text}" Style="{StaticResource ProfileLineLabel}" TextColor="{StaticResource Danger}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                    </DataTrigger>
                </Label.Triggers>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Team.ShowWeaponCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                          CommandParameter="{Binding}" />
                </Label.GestureRecognizers>
            </Label>
        </DataTemplate>
        <!-- A close-combat weapon. -->
        <DataTemplate x:Key="MeleeLine" x:DataType="overview:ProfileLine">
            <Label Text="{Binding Text}" Style="{StaticResource ProfileLineLabel}" TextColor="{StaticResource Signal}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                    </DataTrigger>
                </Label.Triggers>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Team.ShowWeaponCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                          CommandParameter="{Binding}" />
                </Label.GestureRecognizers>
            </Label>
        </DataTemplate>

        <!-- A market row's + count − buttons; + is off once another would not fit the balance. -->
        <ControlTemplate x:Key="CartControls" x:DataType="marketplaces:MarketplaceRow">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Button Text="+"
                        Style="{StaticResource QuantityButton}"
                        TextColor="{StaticResource Signal}"
                        IsEnabled="{Binding IsAffordable}"
                        Command="{Binding Marketplace.IncrementCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                        CommandParameter="{Binding}" />
                <Label Text="{Binding Quantity}"
                       Style="{StaticResource LabelBody}"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"
                       MinimumWidthRequest="28" />
                <Button Text="−"
                        Style="{StaticResource QuantityButton}"
                        TextColor="{StaticResource Danger}"
                        Command="{Binding Marketplace.DecrementCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                        CommandParameter="{Binding}" />
            </HorizontalStackLayout>
        </ControlTemplate>
    </ContentPage.Resources>

    <!-- The title view sits outside the page's content, so the ViewModel is handed over explicitly. -->
    <Shell.TitleView>
        <Grid BindingContext="{Binding BindingContext, Source={x:Reference Root}, x:DataType=ContentPage}"
              x:DataType="overview:SeasonViewModel"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              Padding="4,0,12,0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <Label Text="{Binding RoundTitle}"
                   FontSize="{DynamicResource FontSizeBody}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalTextAlignment="Center"
                   MaxLines="1"
                   LineBreakMode="TailTruncation" />
            <Label Grid.Column="1"
                   Text="{Binding Marketplace.ResourcesText}"
                   FontSize="{DynamicResource FontSizeBody}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Signal}"
                   VerticalTextAlignment="Center"
                   HorizontalOptions="End"
                   MaxLines="1"
                   LineBreakMode="NoWrap" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Company and Play Round -->
        <Border BackgroundColor="{StaticResource Void}"
                Stroke="{StaticResource Hairline}"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                Padding="10,8"
                MinimumHeightRequest="92">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding CompanyName}"
                           FontSize="{DynamicResource FontSizeSubHeadline}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding CompanyType}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           TextColor="{StaticResource TextSecondary}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Renown, StringFormat='RENOWN {0}'}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Signal}"
                           MaxLines="1" />
                </VerticalStackLayout>
                <!-- A bye, for a contract the company cannot play -->
                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource Signal}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        Padding="6,5"
                        WidthRequest="64"
                        HeightRequest="82"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TakeByeCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="TAKE A BYE"
                           TextColor="{StaticResource Signal}"
                           FontAttributes="Bold"
                           FontSize="{DynamicResource FontSizeCaption}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           MaxLines="2"
                           LineBreakMode="WordWrap" />
                </Border>
                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource Signal}"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 4"
                        Padding="10,5"
                        WidthRequest="112"
                        HeightRequest="82"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayRoundCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                        <controls:SvgIcon Source="SVGCache/NonCBIcons/noun-flags.svg"
                                          WidthRequest="36"
                                          HeightRequest="36"
                                          HorizontalOptions="Center" />
                        <Label Text="PLAY ROUND"
                               TextColor="{StaticResource Void}"
                               FontAttributes="Bold"
                               FontSize="{DynamicResource FontSizeCaption}"
                               HorizontalTextAlignment="Center"
                               MaxLines="2"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <!-- Team: a trooper at a time, chosen from the drop-down -->
            <Grid IsVisible="{Binding IsTeamTab}"
                  Padding="5,8,5,0"
                  RowDefinitions="Auto,*"
                  RowSpacing="6">

                <Border BackgroundColor="{StaticResource Plate}"
                        Stroke="{StaticResource Hairline}"
                        StrokeThickness="3"
                        StrokeShape="RoundRectangle 4"
                        Padding="8,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Team.ToggleUnitPickerCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="40,*,20" ColumnSpacing="8" VerticalOptions="Center">
                        <Grid WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center">
                            <controls:SvgIcon Source="{Binding Team.SelectedUnit.LogoSource}" />
                            <controls:SvgIcon Source="SVGCache/CBIcons/lieutenant.svg"
                                              WidthRequest="14"
                                              HeightRequest="14"
                                              HorizontalOptions="Start"
                                              VerticalOptions="Start"
                                              IsVisible="{Binding Team.SelectedUnit.IsLieutenant, FallbackValue=False}" />
                        </Grid>
                        <Label Grid.Column="1"
                               Text="{Binding Team.PickerTitle}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalTextAlignment="Center"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2"
                               Text="▼"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Padding="0,4,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="8">

                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Team.SelectedName}"
                               FontSize="{DynamicResource FontSizeTitleSmall}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding Team.RankText}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{StaticResource Signal}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding Team.SelectedBaseName}"
                                   IsVisible="{Binding Team.HasSelectedBaseName}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Start" />
                            <Label Grid.Column="1"
                                   Text="{Binding Team.SelectedUnitType}"
                                   IsVisible="{Binding Team.HasSelectedUnitType}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>

                    <controls:UnitDisplayConfigurationsView
                        Grid.Row="1"
                        SelectedUnitLogoSource="{Binding Team.Detail.LogoSource}"
                        UnitNameHeading="{Binding Team.Detail.UnitNameHeading}"
                        ShowRegularOrderIcon="{Binding Team.Detail.ShowRegularOrderIcon}"
                        ShowIrregularOrderIcon="{Binding Team.Detail.ShowIrregularOrderIcon}"
                        ShowImpetuousIcon="{Binding Team.Detail.ShowImpetuousIcon}"
                        ShowTacticalAwarenessIcon="{Binding Team.Detail.ShowTacticalAwarenessIcon}"
                        ShowCubeIcon="{Binding Team.Detail.ShowCubeIcon}"
                        ShowCube2Icon="{Binding Team.Detail.ShowCube2Icon}"
                        ShowHackableIcon="{Binding Team.Detail.ShowHackableIcon}"
                        ShowLieutenantIcon="{Binding Team.ShowLieutenantIcon}"
                        LieutenantIconCount="{Binding Team.LieutenantIconCount}"
                        ShowPeripheralIcon="{Binding Team.ShowPeripheralIcon}"
                        UnitHeaderPrimaryColor="{Binding Team.HeaderColors.Primary}"
                        UnitHeaderSecondaryColor="{Binding Team.HeaderColors.Secondary}"
                        UnitHeaderPrimaryTextColor="{Binding Team.HeaderColors.PrimaryText}"
                        UnitHeaderSecondaryTextColor="{Binding Team.HeaderColors.SecondaryText}"
                        UnitMov="{Binding Team.Detail.UnitMov}"
                        UnitCc="{Binding Team.Detail.UnitCc}"
                        UnitBs="{Binding Team.Detail.UnitBs}"
                        UnitPh="{Binding Team.Detail.UnitPh}"
                        UnitWip="{Binding Team.Detail.UnitWip}"
                        UnitArm="{Binding Team.Detail.UnitArm}"
                        UnitBts="{Binding Team.Detail.UnitBts}"
                        UnitVitalityHeader="{Binding Team.Detail.UnitVitalityHeader}"
                        UnitVitality="{Binding Team.Detail.UnitVitality}"
                        UnitS="{Binding Team.Detail.UnitS}"
                        UnitAva="{Binding Team.Detail.UnitAva}"
                        ShowConfigurationsSection="False"
                        ShowUnitName="False"
                        ShowAva="False"
                        ShowSummaryRows="False"
                        EquipmentSummaryFormatted="{Binding Team.Detail.EquipmentSummaryFormatted}"
                        SpecialSkillsSummaryFormatted="{Binding Team.Detail.SpecialSkillsSummaryFormatted}" />

                    <!-- Equipment, Skills, Perks, Weapons, CC Weapons, then the gear slots -->
                    <ScrollView Grid.Row="2">
                        <VerticalStackLayout Spacing="14" Padding="0,2,0,24">

                            <VerticalStackLayout Spacing="3">
                                <Label Text="EQUIPMENT" Style="{StaticResource SectionHeading}" />
                                <BoxView Style="{StaticResource SectionRule}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3"
                                                         BindableLayout.ItemsSource="{Binding Team.Equipment.Left}"
                                                         BindableLayout.ItemTemplate="{StaticResource EquipmentLine}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                         BindableLayout.ItemsSource="{Binding Team.Equipment.Right}"
                                                         BindableLayout.ItemTemplate="{StaticResource EquipmentLine}" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="SPECIAL SKILLS" Style="{StaticResource SectionHeading}" />
                                <BoxView Style="{StaticResource SectionRule}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3"
                                                         BindableLayout.ItemsSource="{Binding Team.Skills.Left}"
                                                         BindableLayout.ItemTemplate="{StaticResource SkillLine}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                         BindableLayout.ItemsSource="{Binding Team.Skills.Right}"
                                                         BindableLayout.ItemTemplate="{StaticResource SkillLine}" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="PERKS" Style="{StaticResource SectionHeading}" />
                                <BoxView Style="{StaticResource SectionRule}" />
                                <Button Text="SPEND PERK POINTS"
                                        IsVisible="{Binding Team.HasPerkPointsToSpend}"
                                        Command="{Binding RankUpCommand}"
                                        BackgroundColor="{StaticResource SignalDim}"
                                        TextColor="{StaticResource Signal}"
                                        BorderColor="{StaticResource Signal}"
                                        BorderWidth="1"
                                        CornerRadius="4"
                                        FontAttributes="Bold"
                                        HeightRequest="40"
                                        HorizontalOptions="Start"
                                        Padding="14,0" />
                                <Label Text="(none)"
                                       IsVisible="{Binding Team.HasPerks, Converter={StaticResource InvertedBoolConverter}}"
                                       TextColor="{StaticResource TextMuted}"
                                       FontSize="{DynamicResource FontSizeBody}" />
                                <VerticalStackLayout Spacing="3" BindableLayout.ItemsSource="{Binding Team.Perks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}" Style="{StaticResource ProfileLineLabel}" TextColor="{StaticResource Signal}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3" IsVisible="{Binding Team.HasInjuries}">
                                <Label Text="INJURIES" Style="{StaticResource SectionHeading}" TextColor="{StaticResource Danger}" />
                                <BoxView Style="{StaticResource SectionRule}" />
                                <VerticalStackLayout Spacing="3" BindableLayout.ItemsSource="{Binding Team.Injuries}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}" Style="{StaticResource ProfileLineLabel}" TextColor="{StaticResource Danger}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="WEAPONS" Style="{StaticResource SectionHeading}" />
                                <BoxView Style="{StaticResource SectionRule}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3"
                                                         BindableLayout.ItemsSource="{Binding Team.RangedWeapons.Left}"
                                                         BindableLayout.ItemTemplate="{StaticResource RangedLine}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                         BindableLayout.ItemsSource="{Binding Team.RangedWeapons.Right}"
                                                         BindableLayout.ItemTemplate="{StaticResource RangedLine}" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="CC WEAPONS" Style="{StaticResource SectionHeading}" />
                                <BoxView Style="{StaticResource SectionRule}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3"
                                                         BindableLayout.ItemsSource="{Binding Team.MeleeWeapons.Left}"
                                                         BindableLayout.ItemTemplate="{StaticResource MeleeLine}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                         BindableLayout.ItemsSource="{Binding Team.MeleeWeapons.Right}"
                                                         BindableLayout.ItemTemplate="{StaticResource MeleeLine}" />
                                </Grid>
                            </VerticalStackLayout>

                            <Label Text="{Binding Team.SwcText}"
                                   TextColor="{StaticResource TextMuted}"
                                   FontAttributes="Bold"
                                   FontSize="{DynamicResource FontSizeCaption}" />
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Team.GearSlots}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="overview:GearSlotPicker">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Title}" Style="{StaticResource SlotHeading}" />
                                            <Picker ItemsSource="{Binding Options}"
                                                    ItemDisplayBinding="{Binding Display, x:DataType=overview:GearOption}"
                                                    SelectedItem="{Binding SelectedOption}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    BackgroundColor="{StaticResource Plate}"
                                                    TitleColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <!-- Tap outside the drop-down to close it -->
                <Grid Grid.Row="1"
                      ZIndex="49"
                      BackgroundColor="Transparent"
                      IsVisible="{Binding Team.IsUnitPickerOpen}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Team.CloseUnitPickerCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <!-- The unit drop-down -->
                <Border Grid.Row="1"
                        ZIndex="50"
                        VerticalOptions="Start"
                        IsVisible="{Binding Team.IsUnitPickerOpen}"
                        BackgroundColor="{StaticResource Plate}"
                        Stroke="{StaticResource Hairline}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        Padding="0">
                    <ScrollView MaximumHeightRequest="320">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Team.Units}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewer:CompanyViewerUnitListItem">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="44,*" MinimumHeightRequest="48" Padding="10,6">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Team.SelectUnitCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                                      CommandParameter="{Binding}" />
                                            </Grid.GestureRecognizers>
                                            <Grid WidthRequest="36" HeightRequest="36">
                                                <controls:SvgIcon Source="{Binding LogoSource}" />
                                                <controls:SvgIcon Source="SVGCache/CBIcons/lieutenant.svg"
                                                                  WidthRequest="14"
                                                                  HeightRequest="14"
                                                                  HorizontalOptions="Start"
                                                                  VerticalOptions="Start"
                                                                  IsVisible="{Binding IsLieutenant}" />
                                            </Grid>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource HairlineBright}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>

            <!-- Inventory: what the company owns, by category -->
            <ScrollView IsVisible="{Binding IsInventoryTab}">
                <VerticalStackLayout Padding="16,12">
                    <Label Text="{Binding Inventory.Message}"
                           IsVisible="{Binding Inventory.HasMessage}"
                           Style="{StaticResource LabelBody}"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           Margin="0,40,0,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Inventory.Sections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="overview:InventorySection">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Title}" Style="{StaticResource ListHeading}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="overview:InventoryItem">
                                                <Border BackgroundColor="{StaticResource Plate}"
                                                        Stroke="{StaticResource HairlineBright}"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="12,8"
                                                        Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52">
                                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                            <Label Text="{Binding Name}"
                                                                   Style="{StaticResource LabelBody}"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   LineBreakMode="WordWrap" />
                                                            <Label Text="{Binding SourcesText}"
                                                                   IsVisible="{Binding HasSources}"
                                                                   Style="{StaticResource LabelCaption}"
                                                                   TextColor="{StaticResource TextMuted}" />
                                                            <Label Text="{Binding RoundsText}"
                                                                   IsVisible="{Binding HasRounds}"
                                                                   Style="{StaticResource LabelCaption}"
                                                                   TextColor="{StaticResource TextSecondary}" />
                                                        </VerticalStackLayout>
                                                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                                            <Label Text="{Binding CountText}"
                                                                   Style="{StaticResource LabelBody}"
                                                                   TextColor="{StaticResource Signal}"
                                                                   FontAttributes="Bold"
                                                                   VerticalTextAlignment="Center"
                                                                   HorizontalTextAlignment="End"
                                                                   MinimumWidthRequest="32" />
                                                            <Button Text="{Binding SellText}"
                                                                    IsVisible="{Binding CanSell}"
                                                                    BackgroundColor="{StaticResource HairlineBright}"
                                                                    TextColor="{StaticResource Caution}"
                                                                    BorderColor="{StaticResource Caution}"
                                                                    BorderWidth="1"
                                                                    CornerRadius="4"
                                                                    FontSize="11"
                                                                    FontAttributes="Bold"
                                                                    Padding="8,4"
                                                                    HeightRequest="36"
                                                                    Command="{Binding Inventory.SellCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                                    CommandParameter="{Binding}" />
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Markets: a store at a time, buying into a cart kept across stores -->
            <Grid IsVisible="{Binding IsMarketplaceTab}" RowDefinitions="Auto,*">
                <Border BackgroundColor="{StaticResource Plate}" StrokeThickness="0" Padding="12,6">
                    <VerticalStackLayout>
                        <Picker Title="Select store..."
                                ItemsSource="{Binding Marketplace.Stores}"
                                ItemDisplayBinding="{Binding Label, x:DataType=overview:StoreChoice}"
                                SelectedItem="{Binding Marketplace.SelectedStore}"
                                Style="{StaticResource OverlayPicker}" />
                        <Button Text="CHOOSE WAR MARKET"
                                IsVisible="{Binding WarMarketChoice.IsNeeded}"
                                BackgroundColor="{StaticResource Hairline}"
                                TextColor="{StaticResource Signal}"
                                FontAttributes="Bold"
                                CornerRadius="4"
                                HeightRequest="38"
                                Margin="0,6,0,0"
                                Command="{Binding WarMarketChoice.OpenCommand}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
                <!-- Additional Recruitment: hire new troopers on the company's own selection screen -->
                <VerticalStackLayout Grid.Row="1" IsVisible="{Binding Marketplace.IsRecruitmentStore}" Padding="16,12" Spacing="10">
                    <Label Text="ADDITIONAL RECRUITMENT" Style="{StaticResource LabelTitleSmall}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Hire new troopers with the CR the company has left. They follow the same rules as the first recruits, and AVA counts every trooper the company has had."
                           Style="{StaticResource LabelBody}"
                           TextColor="{StaticResource TextSecondary}" />
                    <Button Text="RECRUIT TROOPERS"
                            BackgroundColor="{StaticResource Signal}"
                            TextColor="{StaticResource Void}"
                            FontAttributes="Bold"
                            CornerRadius="4"
                            HeightRequest="44"
                            Command="{Binding RecruitCommand}" />
                </VerticalStackLayout>

                <!-- Services: for one trooper at a time -->
                <ScrollView Grid.Row="1" IsVisible="{Binding Marketplace.IsServicesStore}">
                    <VerticalStackLayout Padding="16,12" Spacing="10">
                        <Label Text="SERVICES" Style="{StaticResource LabelTitleSmall}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Picker Title="Pick a trooper…"
                                ItemsSource="{Binding Services.Troopers}"
                                ItemDisplayBinding="{Binding Name, x:DataType=viewer:CompanyViewerUnitListItem}"
                                SelectedItem="{Binding Services.SelectedTrooper}"
                                Style="{StaticResource OverlayPicker}" />
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Services.Options}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="overview:ServiceOption">
                                    <Border Stroke="{StaticResource HairlineBright}" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="12,8" BackgroundColor="{StaticResource Plate}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" Style="{StaticResource LabelBody}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                                    <Label Text="{Binding CostText}" Style="{StaticResource LabelCaption}" TextColor="{StaticResource Signal}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1"
                                                        Text="BUY"
                                                        Style="{StaticResource QuantityButton}"
                                                        WidthRequest="64"
                                                        FontSize="{DynamicResource FontSizeCaption}"
                                                        TextColor="{StaticResource Signal}"
                                                        IsEnabled="{Binding IsAvailable}"
                                                        Command="{Binding Services.BuyCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                            <Label Text="{Binding Description}" Style="{StaticResource LabelCaption}" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding UnavailableReason}" IsVisible="{Binding HasUnavailableReason}" Style="{StaticResource LabelCaption}" TextColor="{StaticResource Danger}" />

                                            <!-- Advanced Therapy: which injury goes -->
                                            <Picker Title="Injury to write off…"
                                                    IsVisible="{Binding ChoosesInjury}"
                                                    ItemsSource="{Binding Services.Injuries, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                    SelectedItem="{Binding Services.SelectedInjury, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                    Style="{StaticResource OverlayPicker}" />

                                            <!-- Forced Retraining: the perk to drop and the one of the same tier to take -->
                                            <VerticalStackLayout Spacing="6" IsVisible="{Binding ChoosesPerks}">
                                                <Picker Title="Perk to retrain…"
                                                        ItemsSource="{Binding Services.RetrainablePerks, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                        ItemDisplayBinding="{Binding Name, x:DataType=rankUp:PerkOption}"
                                                        SelectedItem="{Binding Services.SelectedRetrainPerk, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                        Style="{StaticResource OverlayPicker}" />
                                                <Picker Title="New perk…"
                                                        ItemsSource="{Binding Services.Replacements, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                        ItemDisplayBinding="{Binding Name, x:DataType=rankUp:PerkOption}"
                                                        SelectedItem="{Binding Services.SelectedReplacement, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                        Style="{StaticResource OverlayPicker}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView Grid.Row="1" IsVisible="{Binding Marketplace.ShowsStock}">
                    <VerticalStackLayout Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                            <Label Text="{Binding Marketplace.StoreName}"
                                   Style="{StaticResource LabelTitleSmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalTextAlignment="Center" />
                            <Button Grid.Column="1"
                                    Text="BUY"
                                    Style="{StaticResource ButtonCaption}"
                                    BackgroundColor="{StaticResource SignalDim}"
                                    TextColor="{StaticResource Signal}"
                                    BorderColor="{StaticResource Signal}"
                                    BorderWidth="1"
                                    CornerRadius="6"
                                    Padding="12,6"
                                    HeightRequest="36"
                                    Command="{Binding Marketplace.BuyCommand}">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <Label Text="{Binding Marketplace.AlignmentText}"
                               IsVisible="{Binding Marketplace.HasAlignmentText}"
                               Style="{StaticResource LabelBody}"
                               TextColor="{StaticResource TextMuted}"
                               Margin="0,0,0,10" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Marketplace.ItemGroups}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="marketplaces:StoreItemGroup">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Category}" Style="{StaticResource ListHeading}" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="marketplaces:StoreItemRow">
                                                    <Border Stroke="{StaticResource HairlineBright}" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="12,6,8,6" Margin="0,0,0,3">
                                                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52">
                                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                                <VerticalStackLayout.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding Marketplace.ShowDetailCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                                                          CommandParameter="{Binding}" />
                                                                </VerticalStackLayout.GestureRecognizers>
                                                                <Label Text="{Binding Name}" Style="{StaticResource LabelBody}" TextColor="{StaticResource TextPrimary}">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAffordable}" Value="False">
                                                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                                <Label Text="{Binding CostDisplay}" Style="{StaticResource LabelCaption}" TextColor="{StaticResource Signal}">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAffordable}" Value="False">
                                                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                            </VerticalStackLayout>
                                                            <ContentView Grid.Column="1" ControlTemplate="{StaticResource CartControls}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="ARMOR UPGRADES" Style="{StaticResource ListHeading}" IsVisible="{Binding Marketplace.HasTroopTypes}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Marketplace.TroopTypeRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="marketplaces:TroopTypeRow">
                                    <Border Stroke="{StaticResource HairlineBright}" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="12,6,8,6" Margin="0,0,0,3">
                                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52">
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Marketplace.ShowDetailCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                                          CommandParameter="{Binding}" />
                                                </VerticalStackLayout.GestureRecognizers>
                                                <Label Text="{Binding DisplayName}" Style="{StaticResource LabelBody}" TextColor="{StaticResource TextPrimary}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAffordable}" Value="False">
                                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding StatDisplay}" Style="{StaticResource LabelCaption}" TextColor="{StaticResource TextMuted}" />
                                                <Label Text="{Binding Abilities}"
                                                       IsVisible="{Binding HasAbilities}"
                                                       Style="{StaticResource LabelCaption}"
                                                       TextColor="{StaticResource TextMuted}"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding CostDisplay}" Style="{StaticResource LabelCaption}" TextColor="{StaticResource Signal}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAffordable}" Value="False">
                                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                            <ContentView Grid.Column="1" ControlTemplate="{StaticResource CartControls}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="AUGMENTS" Style="{StaticResource ListHeading}" IsVisible="{Binding Marketplace.HasAugments}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Marketplace.AugmentRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="marketplaces:AugmentRow">
                                    <Border Stroke="{StaticResource HairlineBright}" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="12,6,8,6" Margin="0,0,0,3">
                                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="52">
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Marketplace.ShowDetailCommand, Source={RelativeSource AncestorType={x:Type overview:SeasonViewModel}}, x:DataType=overview:SeasonViewModel}"
                                                                          CommandParameter="{Binding}" />
                                                </VerticalStackLayout.GestureRecognizers>
                                                <Label Text="{Binding Name}" Style="{StaticResource LabelBody}" TextColor="{StaticResource TextPrimary}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAffordable}" Value="False">
                                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding CostDisplay}" Style="{StaticResource LabelCaption}" TextColor="{StaticResource Signal}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAffordable}" Value="False">
                                                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                            <ContentView Grid.Column="1" ControlTemplate="{StaticResource CartControls}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- A weapon or market row in full -->
        <controls:MarketplaceDetailPopupView Grid.RowSpan="3" BindingContext="{Binding DetailPopup}" />

        <!-- Choosing the round's War Market -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding WarMarketChoice.IsOpen}" BackgroundColor="#D00E1116">
            <Border BackgroundColor="{StaticResource Plate}"
                    Stroke="{StaticResource Hairline}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 4"
                    Margin="16,60,16,24"
                    VerticalOptions="Start">
                <ScrollView>
                    <VerticalStackLayout Padding="16,14" Spacing="14">
                        <Label Text="Choose this round's War Market"
                               FontAttributes="Bold"
                               FontSize="{DynamicResource FontSizeSectionHeader}"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="Center" />

                        <Border Style="{StaticResource OverlayPanel}" IsVisible="{Binding WarMarketChoice.HasFactionMarkets}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="YOUR FACTION'S MARKET" TextColor="{StaticResource TextMuted}" FontAttributes="Bold" FontSize="{DynamicResource FontSizeCaption}" />
                                <Picker Title="Select a market..."
                                        ItemsSource="{Binding WarMarketChoice.FactionMarketChoices}"
                                        SelectedItem="{Binding WarMarketChoice.SelectedFactionMarket}"
                                        Style="{StaticResource OverlayPicker}" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Rolling for a War Market opens after the first contract."
                               IsVisible="{Binding WarMarketChoice.CanRoll, Converter={StaticResource InvertedBoolConverter}}"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               HorizontalTextAlignment="Center" />

                        <Border Style="{StaticResource OverlayPanel}" IsVisible="{Binding WarMarketChoice.CanRoll}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="ROLL FOR ANOTHER MARKET" TextColor="{StaticResource TextMuted}" FontAttributes="Bold" FontSize="{DynamicResource FontSizeCaption}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding WarMarketChoice.ResultText}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           FontAttributes="Bold"
                                           VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding WarMarketChoice.ResultTone}" Value="{x:Static overview:StoreSearchTone.Found}">
                                                <Setter Property="TextColor" Value="{StaticResource Signal}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding WarMarketChoice.ResultTone}" Value="{x:Static overview:StoreSearchTone.Choose}">
                                                <Setter Property="TextColor" Value="{StaticResource Caution}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding WarMarketChoice.ResultTone}" Value="{x:Static overview:StoreSearchTone.Problem}">
                                                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Button Grid.Column="1"
                                            Text="ROLL"
                                            BackgroundColor="{StaticResource Hairline}"
                                            TextColor="{StaticResource Signal}"
                                            FontAttributes="Bold"
                                            CornerRadius="4"
                                            Padding="14,0"
                                            HeightRequest="38"
                                            Command="{Binding WarMarketChoice.RollCommand}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource OverlayPanel}" IsVisible="{Binding WarMarketChoice.CanRoll}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="OR PICK THE ROLL MADE AT THE TABLE" TextColor="{StaticResource TextMuted}" FontAttributes="Bold" FontSize="{DynamicResource FontSizeCaption}" />
                                <Picker Title="Select 1-20..."
                                        ItemsSource="{Binding WarMarketChoice.RollOptions}"
                                        ItemDisplayBinding="{Binding Label, x:DataType=overview:StoreRollOption}"
                                        SelectedItem="{Binding WarMarketChoice.SelectedRoll}"
                                        Style="{StaticResource OverlayPicker}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource OverlayPanel}" Stroke="{StaticResource Caution}" IsVisible="{Binding WarMarketChoice.IsChoosingAny}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="CHOOSE ANY MARKET (19-20)" TextColor="{StaticResource Caution}" FontAttributes="Bold" FontSize="{DynamicResource FontSizeCaption}" />
                                <Picker Title="Select a store..."
                                        ItemsSource="{Binding WarMarketChoice.Choices}"
                                        SelectedItem="{Binding WarMarketChoice.SelectedChoice}"
                                        Style="{StaticResource OverlayPicker}" />
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="CONFIRM"
                                BackgroundColor="{StaticResource Signal}"
                                TextColor="{StaticResource Void}"
                                FontAttributes="Bold"
                                HeightRequest="44"
                                CornerRadius="4"
                                Command="{Binding WarMarketChoice.ConfirmCommand}">
                            <Button.Triggers>
                                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="LATER"
                                BackgroundColor="{StaticResource Hairline}"
                                TextColor="{StaticResource TextPrimary}"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                CornerRadius="4"
                                Command="{Binding WarMarketChoice.CloseCommand}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Tabs; the active one's rail lights up -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource Plate}"
                Stroke="{StaticResource Hairline}"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                Padding="0">
            <Grid ColumnDefinitions="*,*,*">
                <Grid RowDefinitions="2,*">
                    <BoxView BackgroundColor="{StaticResource Signal}" IsVisible="{Binding IsTeamTab}" />
                    <Button Grid.Row="1"
                            Text="TEAM"
                            Style="{StaticResource TabButton}"
                            Command="{Binding ShowTabCommand}"
                            CommandParameter="{x:Static overview:SeasonTab.Team}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsTeamTab}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Signal}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="2,*">
                    <BoxView BackgroundColor="{StaticResource Signal}" IsVisible="{Binding IsInventoryTab}" />
                    <Button Grid.Row="1"
                            Text="INVENTORY"
                            Style="{StaticResource TabButton}"
                            Command="{Binding ShowTabCommand}"
                            CommandParameter="{x:Static overview:SeasonTab.Inventory}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsInventoryTab}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Signal}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
                <Grid Grid.Column="2" RowDefinitions="2,*">
                    <BoxView BackgroundColor="{StaticResource Signal}" IsVisible="{Binding IsMarketplaceTab}" />
                    <Button Grid.Row="1"
                            Text="MARKETS"
                            Style="{StaticResource TabButton}"
                            Command="{Binding ShowTabCommand}"
                            CommandParameter="{x:Static overview:SeasonTab.Marketplace}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsMarketplaceTab}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Signal}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</views:ContentPageBase>
