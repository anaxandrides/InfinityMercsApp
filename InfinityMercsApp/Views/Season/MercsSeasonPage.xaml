<?xml version="1.0" encoding="utf-8" ?>
<layout:AdaptiveContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:seasonViewModels="clr-namespace:InfinityMercsApp.ViewModels.Season;assembly=InfinityMercsApp.ViewModels"
             xmlns:layout="clr-namespace:InfinityMercsApp.Views.Adaptive"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="InfinityMercsApp.Views.Season.MercsSeasonPage"
             x:DataType="seasonViewModels:MercsSeasonPageViewModel"
             x:Name="SeasonRoot"
             Title="Home"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Void}">

    <ContentPage.Behaviors>
        <!-- Behaviors sit outside the visual tree, so the ViewModel is handed over explicitly. -->
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference SeasonRoot}, x:DataType=ContentPage}"
                                        x:DataType="seasonViewModels:MercsSeasonPageViewModel"
                                        EventName="LayoutModeChanged"
                                        Command="{Binding ApplyLayoutCommand}"
                                        CommandParameter="{Binding LayoutMode, Source={x:Reference SeasonRoot}, x:DataType=layout:AdaptiveContentPage}" />
    </ContentPage.Behaviors>

    <Grid layout:GridLayout.Columns="{Binding Layout.Columns}" layout:GridLayout.Rows="{Binding Layout.Rows}" RowSpacing="0">

        <!-- Logo and title -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="{DynamicResource SpacingLarge}"
                             VerticalOptions="Center"
                             Padding="24,0">
            <Image Source="m2_no_bg_short.webp"
                   HeightRequest="180"
                   HorizontalOptions="Center"
                   Aspect="AspectFit" />

            <Label Text="MERCS SEASON"
                   FontSize="{DynamicResource FontSizeHeadline}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Campaigns, downtime, and the long war."
                   FontSize="{DynamicResource FontSizeBody}"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Action panel -->
        <Grid layout:GridLayout.Cell="{Binding Layout.ActionCell}"
              Padding="{Binding Layout.ActionPadding, Converter={StaticResource Inset}}"
              VerticalOptions="{Binding Layout.ActionVerticalOptions, Converter={StaticResource Alignment}}"
              HorizontalOptions="{Binding Layout.ActionHorizontalOptions, Converter={StaticResource Alignment}}"
              MaximumWidthRequest="{Binding Layout.ActionMaximumWidth}">

            <!-- Main actions, then the account, set apart so it doesn't read as part of the same group -->
            <VerticalStackLayout IsVisible="{Binding IsChoosingNewSeason, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="{DynamicResource SpacingMedium}">
                    <Button Text="LOAD SEASON"
                            Command="{Binding LoadSeasonCommand}"
                            HorizontalOptions="Fill" />
                    <Button Text="START NEW SEASON"
                            BackgroundColor="{StaticResource Signal}"
                            TextColor="{StaticResource Void}"
                            BorderColor="{StaticResource Signal}"
                            FontAttributes="Bold"
                            Command="{Binding StartNewSeasonCommand}"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>

                <Button Text="LOG IN"
                        Margin="0,40,0,0"
                        Padding="20,0"
                        HeightRequest="36"
                        FontSize="{DynamicResource FontSizeCaption}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource HairlineBright}"
                        BorderWidth="1"
                        HorizontalOptions="Center"
                        IsVisible="{Binding ShowLogIn}"
                        Command="{Binding LogInCommand}" />
                <Label Text="{Binding AccountText}"
                       Margin="0,40,0,0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding ShowAccount}" />
            </VerticalStackLayout>

            <!-- New-season sub-choices (hidden until Start New Season is tapped) -->
            <VerticalStackLayout IsVisible="{Binding IsChoosingNewSeason}"
                                 Spacing="{DynamicResource SpacingMedium}">
                <Label Text="Choose your starting point:"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4" />
                <Button Text="LOAD A COMPANY"
                        Command="{Binding LoadCompanyCommand}"
                        HorizontalOptions="Fill" />
                <Button Text="CREATE A NEW TEAM"
                        BackgroundColor="{StaticResource Signal}"
                        TextColor="{StaticResource Void}"
                        BorderColor="{StaticResource Signal}"
                        FontAttributes="Bold"
                        Command="{Binding CreateNewTeamCommand}"
                        HorizontalOptions="Fill" />
                <Button Text="CANCEL"
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        BorderWidth="0"
                        TextColor="{StaticResource TextMuted}"
                        Command="{Binding CancelNewSeasonCommand}"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>

        </Grid>
    </Grid>
</layout:AdaptiveContentPage>
