<?xml version="1.0" encoding="utf-8" ?>
<baseViews:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:seasonViewModels="clr-namespace:InfinityMercsApp.ViewModels.Season"
             xmlns:seasonItems="clr-namespace:InfinityMercsApp.ViewModels.Season.Items"
             xmlns:inducements="clr-namespace:InfinityMercsApp.ViewModels.Season.Inducements"
             xmlns:inducementItems="clr-namespace:InfinityMercsApp.ViewModels.Season.Inducements.Items"
             xmlns:baseViews="clr-namespace:InfinityMercsApp.Views.Base"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:season="clr-namespace:InfinityMercsApp.Views.Season"
             x:Class="InfinityMercsApp.Views.Season.PlayModePage"
             x:DataType="seasonViewModels:PlayModeViewModel"
             x:Name="PageRoot"
             Title="Play Round"
             BackgroundColor="{StaticResource Void}">

    <ContentPage.Resources>
        <Style x:Key="ShopHeading" TargetType="Label">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="ShopRow" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Plate}" />
            <Setter Property="Stroke" Value="{StaticResource Hairline}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="StrokeShape" Value="RoundRectangle 4" />
        </Style>
        <Style x:Key="ShopCost" TargetType="Label">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Signal}" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ShopRemove" TargetType="Button">
            <Setter Property="Text" Value="✕" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Danger}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Plate}"
                Stroke="{StaticResource Hairline}"
                StrokeThickness="1"
                Padding="16,12"
                StrokeShape="Rectangle">
            <Label Text="DEPLOYMENT"
                   FontSize="{DynamicResource FontSizeSubHeadline}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalTextAlignment="Center" />
        </Border>

        <!-- Body: unit strip + detail panel -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">

            <!-- Horizontal unit strip with checkboxes -->
            <ScrollView Grid.Row="0"
                        x:Name="UnitStripScrollView"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="8,8,8,4">
                <HorizontalStackLayout
                    BindableLayout.ItemsSource="{Binding DeploymentUnits}"
                    Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="seasonItems:DeploymentUnitItem">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <controls:CompanyViewerUnitTileView
                                    ItemTappedCommand="{Binding ViewModel.SelectUnitCommand, Source={x:Reference PageRoot}, x:DataType=season:PlayModePage}"
                                    PanScrollCommand="{Binding TileStripPanCommand, Source={x:Reference PageRoot}, x:DataType=season:PlayModePage}" />
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsEnabled="{Binding IsCheckboxEnabled}"
                                          HorizontalOptions="Center"
                                          Color="{StaticResource Signal}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Divider -->
            <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,4,0,0" />

            <!-- Detail panel -->
            <ScrollView Grid.Row="2" Padding="16,12,16,4">
                <VerticalStackLayout Spacing="14">

                    <!-- Placeholder when nothing selected -->
                    <Label Text="Select a unit above to view details"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           Margin="0,24,0,0"
                           IsVisible="{Binding NoUnitSelected}" />

                    <!-- Unit name -->
                    <Label Text="{Binding SelectedUnit.Name}"
                           FontSize="{DynamicResource FontSizeTitleSmall}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           IsVisible="{Binding HasSelectedUnit}" />

                    <!-- Stats block -->
                    <Border BackgroundColor="{StaticResource Plate}"
                            Stroke="{StaticResource Hairline}"
                            StrokeThickness="1"
                            Padding="8,10"
                            IsVisible="{Binding HasSelectedUnit}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">

                            <!-- Header row -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*,*,*,*,*">
                                <Label Grid.Column="0" Text="MOV"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="CC"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="BS"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Column="3" Text="PH"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Column="4" Text="WIP"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Column="5" Text="ARM"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Column="6" Text="BTS"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Column="7"
                                       Text="{Binding SelectedUnit.VitalityHeader}"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Column="8" Text="S"
                                       FontSize="{DynamicResource FontSizeMicro}" TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                            </Grid>

                            <!-- Value row -->
                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*,*,*">
                                <Label Grid.Column="0"
                                       Text="{Binding SelectedUnit.UnitMov}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding SelectedUnit.UnitCc}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding SelectedUnit.UnitBs}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3"
                                       Text="{Binding SelectedUnit.UnitPh}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="4"
                                       Text="{Binding SelectedUnit.UnitWip}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="5"
                                       Text="{Binding SelectedUnit.UnitArm}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="6"
                                       Text="{Binding SelectedUnit.UnitBts}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="7"
                                       Text="{Binding SelectedUnit.UnitVitality}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Column="8"
                                       Text="{Binding SelectedUnit.UnitS}"
                                       FontSize="{DynamicResource FontSizeBody}" TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- Equipment -->
                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding HasSelectedUnit}">
                        <Label Text="Equipment"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding SelectedUnit.Equipment}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- Skills -->
                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding HasSelectedUnit}">
                        <Label Text="Skills"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontAttributes="Bold"
                               TextColor="#F59E0B" />
                        <Label Text="{Binding SelectedUnit.Skills}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- Weapons -->
                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding HasSelectedUnit}">
                        <Label Text="Weapons"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding SelectedUnit.RangedWeapons}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{StaticResource Danger}"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding SelectedUnit.MeleeWeapons}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{StaticResource Signal}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- Deploy area -->
        <VerticalStackLayout Grid.Row="2" Spacing="4" Padding="16,8,16,12">
            <!-- Inducements: the underdog gets half the renown difference, rounded down to 5. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding DeployedRenown, StringFormat='Deployed renown: {0}'}"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextColor="{StaticResource TextSecondary}"
                       VerticalTextAlignment="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding OpponentRenownText}"
                       Placeholder="Opponent's renown"
                       Keyboard="Numeric"
                       FontSize="{DynamicResource FontSizeBody}"
                       MinimumWidthRequest="150" />
                <HorizontalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding IsCooperative}" Color="{StaticResource Signal}" />
                    <Label Text="Co-op"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextColor="{StaticResource TextMuted}"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Grid>
            <Label Text="{Binding InducementText}"
                   FontSize="{DynamicResource FontSizeBody}"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />
            <Button Text="{Binding Shop.LeftText, StringFormat='INDUCEMENTS · {0}'}"
                    IsVisible="{Binding CanSpendInducements}"
                    Command="{Binding Shop.OpenCommand}"
                    BackgroundColor="{StaticResource PlateRaised}"
                    BorderColor="{StaticResource Signal}"
                    BorderWidth="1"
                    TextColor="{StaticResource Signal}"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
            <Label Text="{Binding Shop.Summary}"
                   IsVisible="{Binding Shop.HasPurchases}"
                   FontSize="{DynamicResource FontSizeCaption}"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
            <!-- A Proxy Pack picks the loadout its Lone Wolf starts in; the others deploy as Aspects. -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" IsVisible="{Binding IsProxyPack}">
                <Label Text="Deploy as the Lone Wolf:"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
                <Picker ItemsSource="{Binding LoneWolfLoadouts}"
                        ItemDisplayBinding="{Binding Name, x:DataType=seasonItems:DeploymentUnitItem}"
                        SelectedItem="{Binding StartingLoneWolf}"
                        TextColor="{StaticResource TextPrimary}"
                        MinimumWidthRequest="160" />
            </HorizontalStackLayout>
            <Label Text="{Binding DeploymentStatusText}"
                   FontSize="{DynamicResource FontSizeBody}"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsEliteDeployment}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Signal}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Button Text="DEPLOY"
                    BackgroundColor="{StaticResource Signal}"
                    TextColor="{StaticResource Void}"
                    BorderColor="{StaticResource Signal}"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    WidthRequest="200"
                    Command="{Binding DeployCommand}" />
        </VerticalStackLayout>

        <!-- The inducements pop-up: hire troops, buy command tokens and rent gear for this contract. -->
        <ScrollView Grid.RowSpan="3"
                    BackgroundColor="{StaticResource Void}"
                    IsVisible="{Binding Shop.IsOpen}">
            <VerticalStackLayout Padding="16,12" Spacing="6" BindingContext="{Binding Shop}" x:DataType="inducements:InducementShopViewModel">
                <Label Text="INDUCEMENTS"
                       FontSize="{DynamicResource FontSizeSubHeadline}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding LeftText}"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextColor="{StaticResource Signal}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Everything bought lasts for this contract only."
                       FontSize="{DynamicResource FontSizeCaption}"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center" />

                <!-- Hired so far, then the Troops for Hire table. -->
                <Label Text="TROOPS FOR HIRE · up to 7 troopers; those past 6 give only impetuous orders" Style="{StaticResource ShopHeading}" />
                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Hired}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="inducementItems:HiredTroopRow">
                            <Border Style="{StaticResource ShopRow}" Stroke="{StaticResource Signal}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Column="1" Text="{Binding Cost}" Style="{StaticResource ShopCost}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ShopRemove}"
                                            Command="{Binding ViewModel.Shop.DismissCommand, Source={x:Reference PageRoot}, x:DataType=season:PlayModePage}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding HireOffers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="inducementItems:HireOfferItem">
                            <Border Style="{StaticResource ShopRow}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewModel.Shop.HireCommand, Source={x:Reference PageRoot}, x:DataType=season:PlayModePage}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="{Binding CostText}" Style="{StaticResource ShopCost}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Command tokens: 10 each, two at most. -->
                <Label Text="COMMAND TOKENS · 10 each, up to 2" Style="{StaticResource ShopHeading}" />
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Button Text="−"
                            Command="{Binding ReturnCommandTokenCommand}"
                            BackgroundColor="{StaticResource PlateRaised}"
                            TextColor="{StaticResource TextPrimary}"
                            WidthRequest="48" />
                    <Label Text="{Binding CommandTokens}"
                           FontSize="{DynamicResource FontSizeSubHeadline}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center" />
                    <Button Text="+"
                            Command="{Binding BuyCommandTokenCommand}"
                            BackgroundColor="{StaticResource PlateRaised}"
                            TextColor="{StaticResource TextPrimary}"
                            WidthRequest="48" />
                </HorizontalStackLayout>

                <!-- Rented so far, then the Rented Equipment table. -->
                <Label Text="RENTED EQUIPMENT · replaces what the slot holds, for this contract" Style="{StaticResource ShopHeading}" />
                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Rentals}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="inducementItems:RentalRow">
                            <Border Style="{StaticResource ShopRow}" Stroke="{StaticResource Signal}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Text}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Column="1" Text="{Binding Rental.Cost}" Style="{StaticResource ShopCost}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ShopRemove}"
                                            Command="{Binding ViewModel.Shop.ReturnRentalCommand, Source={x:Reference PageRoot}, x:DataType=season:PlayModePage}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding RentalOffers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="inducementItems:RentalOfferItem">
                            <Border Style="{StaticResource ShopRow}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewModel.Shop.RentCommand, Source={x:Reference PageRoot}, x:DataType=season:PlayModePage}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding Detail}"
                                               FontSize="{DynamicResource FontSizeMicro}"
                                               TextColor="{StaticResource TextMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding CostText}" Style="{StaticResource ShopCost}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="DONE"
                        Command="{Binding CloseCommand}"
                        BackgroundColor="{StaticResource Signal}"
                        TextColor="{StaticResource Void}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        WidthRequest="200"
                        Margin="0,12,0,0" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</baseViews:ContentPageBase>
