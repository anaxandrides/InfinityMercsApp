<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:InfinityMercsApp.Views.Behaviors"
             xmlns:downtime="clr-namespace:InfinityMercsApp.ViewModels.Season.Downtime"
             xmlns:outcomes="clr-namespace:InfinityMercsApp.Domain.Season.Downtime;assembly=InfinityMercsApp.Domain"
             xmlns:views="clr-namespace:InfinityMercsApp.Views"
             x:Class="InfinityMercsApp.Views.Season.DowntimePage"
             x:DataType="downtime:DowntimeViewModel"
             Title="Downtime"
             BackgroundColor="{StaticResource Void}">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#161B22" />
            <Setter Property="Stroke" Value="#3A4554" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="Label">
            <Setter Property="TextColor" Value="#8A97A8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Detail" TargetType="Label">
            <Setter Property="TextColor" Value="#B5C0CE" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#3A4554" />
            <Setter Property="TextColor" Value="#E6EBF2" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HeightRequest" Value="36" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12,16,16">

        <Label Text="DOWNTIME EVENT"
               FontSize="{DynamicResource FontSizeTitleSmall}"
               FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}"
               Margin="0,0,0,12" />

        <ScrollView Grid.Row="1">
            <ScrollView.Behaviors>
                <behaviors:ScrollToEndBehavior />
            </ScrollView.Behaviors>
            <VerticalStackLayout Spacing="12">
                <Label Text="Press Roll for a random event, or pick a number and press Real."
                       IsVisible="{Binding HasEvent, Converter={StaticResource InvertedBoolConverter}}"
                       TextColor="{StaticResource TextMuted}"
                       FontSize="{DynamicResource FontSizeBody}"
                       HorizontalTextAlignment="Center"
                       Margin="0,40,0,0" />

                <!-- The roll and the event it picked. -->
                <Border Style="{StaticResource Card}" Stroke="#34D399" Padding="12,8" IsVisible="{Binding HasEvent}">
                    <Label Text="{Binding RollHeader}"
                           TextColor="#E6EBF2"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalTextAlignment="Center" />
                </Border>
                <Label Text="{Binding CurrentEvent.Description, FallbackValue=''}"
                       IsVisible="{Binding HasEvent}"
                       TextColor="#B5C0CE"
                       FontSize="14" />
                <Label Text="{Binding EventTraitsText}"
                       IsVisible="{Binding HasEventTraits}"
                       TextColor="#F59E0B"
                       FontSize="13"
                       FontAttributes="Bold" />

                <!-- A quiet week: any event may be picked instead, or none. -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsChoosingFromEventList}">
                    <Label Text="SELECT AN EVENT" Style="{StaticResource SectionHeading}" Margin="0,4,0,6" />
                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding EventOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="downtime:DowntimeEventOption">
                                <Border Style="{StaticResource Card}" Padding="12,10">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsEventListClosed, Source={RelativeSource AncestorType={x:Type downtime:DowntimeViewModel}}, x:DataType=downtime:DowntimeViewModel}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PickEventCommand, Source={RelativeSource AncestorType={x:Type downtime:DowntimeViewModel}}, x:DataType=downtime:DowntimeViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Text}" TextColor="#E6EBF2" FontSize="13" LineBreakMode="WordWrap" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="NO EVENT"
                            Style="{StaticResource ActionButton}"
                            TextColor="#8A97A8"
                            HeightRequest="40"
                            Margin="0,8,0,0"
                            Command="{Binding NoEventCommand}" />
                </VerticalStackLayout>

                <!-- The event's choices; only the picked one stays. -->
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding ChoiceCards}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="downtime:DowntimeChoiceCard">
                            <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="6" Padding="12">
                                    <Label Text="{Binding Header}" Style="{StaticResource SectionHeading}" />
                                    <Label Text="{Binding Description}" TextColor="#E6EBF2" FontSize="14" />
                                    <Label Text="{Binding TraitsText}"
                                           IsVisible="{Binding HasTraits}"
                                           TextColor="#F59E0B"
                                           FontSize="12"
                                           FontAttributes="Bold" />
                                    <Button Text="PICK"
                                            Style="{StaticResource ActionButton}"
                                            Margin="0,4,0,0"
                                            Command="{Binding PickChoiceCommand, Source={RelativeSource AncestorType={x:Type downtime:DowntimeViewModel}}, x:DataType=downtime:DowntimeViewModel}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Resolution: who performs it, the test, and what happens. -->
                <VerticalStackLayout Spacing="10" Margin="0,8,0,0" IsVisible="{Binding HasChoice}">
                    <Label Text="RESOLUTION" Style="{StaticResource SectionHeading}" />

                    <Label Text="{Binding ParticipantPrompt}" Style="{StaticResource Detail}" FontAttributes="Bold" />
                    <Label Text="No eligible mercs found."
                           IsVisible="{Binding HasNoCandidates}"
                           TextColor="#F87171"
                           FontSize="13" />
                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Participants}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="downtime:DowntimeParticipantItem">
                                <Border BackgroundColor="#3A4554"
                                        Stroke="#3A4554"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="12,10">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDimmed}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="#34D399" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PickParticipantCommand, Source={RelativeSource AncestorType={x:Type downtime:DowntimeViewModel}}, x:DataType=downtime:DowntimeViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding DisplayName}"
                                               TextColor="#E6EBF2"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1"
                                               Text="{Binding MissingText}"
                                               IsVisible="{Binding IsEligible, Converter={StaticResource InvertedBoolConverter}}"
                                               TextColor="#F87171"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="End" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TargetText}"
                                               IsVisible="{Binding ShowTarget}"
                                               TextColor="#34D399"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding PerformedByText}"
                           IsVisible="{Binding HasParticipant}"
                           TextColor="#34D399"
                           FontSize="13"
                           FontAttributes="Bold" />

                    <!-- P2P: CR can be spent to raise the target. -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowsCrSpend}">
                        <Label Text="P2P — Spend CR to boost target (optional):" Style="{StaticResource Detail}" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="CR to spend:" TextColor="#8A97A8" FontSize="13" VerticalTextAlignment="Center" />
                            <Stepper Grid.Column="1"
                                     Minimum="0"
                                     Maximum="999"
                                     Increment="1"
                                     Value="{Binding CrToSpend}"
                                     IsEnabled="{Binding IsSpendingCr}"
                                     HorizontalOptions="Fill" />
                            <Label Grid.Column="2"
                                   Text="{Binding CrSpendTargetText}"
                                   TextColor="#34D399"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                        </Grid>
                        <Button Text="CONFIRM SPEND"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding ConfirmSpendCommand}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding TestText}" IsVisible="{Binding HasTestText}" Style="{StaticResource Detail}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsTestUnresolvable}" Value="True">
                                <Setter Property="TextColor" Value="#F87171" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding RolledText}"
                           IsVisible="{Binding HasRolledText}"
                           TextColor="#E6EBF2"
                           FontSize="13"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasOutcome}">
                        <Label Text="{Binding OutcomeText}" TextColor="#E6EBF2" FontAttributes="Bold" FontSize="14">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Outcome}" Value="{x:Static outcomes:PassFailOutcome.Fail}">
                                    <Setter Property="TextColor" Value="#F87171" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Outcome}" Value="{x:Static outcomes:PassFailOutcome.Pass}">
                                    <Setter Property="TextColor" Value="#34D399" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Outcome}" Value="{x:Static outcomes:PassFailOutcome.CritPass}">
                                    <Setter Property="TextColor" Value="#FBBF24" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="No mechanical effect."
                               IsVisible="{Binding HasNoConsequences}"
                               TextColor="#8A97A8"
                               FontSize="13" />
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding ConsequenceLines}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Detail}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- What to do next and the dice; Back to Base once the event is settled or can't go on. -->
        <VerticalStackLayout Grid.Row="2" Spacing="6" Margin="0,12,0,0">
            <Label Text="{Binding RollPrompt}"
                   IsVisible="{Binding IsResolved, Converter={StaticResource InvertedBoolConverter}}"
                   TextColor="{StaticResource TextMuted}"
                   FontSize="{DynamicResource FontSizeCaption}"
                   HorizontalTextAlignment="Center" />
            <Grid ColumnDefinitions="*,Auto,*"
                  ColumnSpacing="8"
                  IsVisible="{Binding CanGoBackToBase, Converter={StaticResource InvertedBoolConverter}}">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding CanRollDice}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Grid.Triggers>
                <Button Text="ROLL"
                        BackgroundColor="{StaticResource Signal}"
                        TextColor="{StaticResource Void}"
                        FontAttributes="Bold"
                        Command="{Binding RollCommand}" />
                <Picker Grid.Column="1"
                        Title="1-20"
                        WidthRequest="90"
                        TextColor="{StaticResource TextPrimary}"
                        BackgroundColor="{StaticResource HairlineBright}"
                        ItemsSource="{Binding RealRolls}"
                        SelectedItem="{Binding SelectedRealRoll}"
                        IsEnabled="{Binding CanRollDice}" />
                <Button Grid.Column="2"
                        Text="REAL"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Signal}"
                        BorderWidth="1"
                        TextColor="{StaticResource TextPrimary}"
                        FontAttributes="Bold"
                        Command="{Binding RealCommand}" />
            </Grid>

            <Button Text="CONTINUE"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextPrimary}"
                    BorderColor="{StaticResource Signal}"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    IsVisible="{Binding CanGoBackToBase}"
                    Command="{Binding BackToBaseCommand}" />
        </VerticalStackLayout>

    </Grid>
</views:ContentPageBase>
