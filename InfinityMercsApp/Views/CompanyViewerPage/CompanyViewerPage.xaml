<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:InfinityMercsApp.Views.Behaviors"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:viewer="clr-namespace:InfinityMercsApp.ViewModels.Company.Viewer"
             xmlns:views="clr-namespace:InfinityMercsApp.Views"
             x:Class="InfinityMercsApp.Views.CompanyViewerPage"
             x:DataType="viewer:CompanyViewerViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <Style x:Key="NameActionIcon" TargetType="controls:SvgIcon">
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="6">
        <!-- The company's troopers; tapping one shows it below. -->
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <ScrollView.Behaviors>
                <behaviors:DragToScrollBehavior Orientation="Horizontal" />
            </ScrollView.Behaviors>
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CompanyUnits}" Spacing="8" Padding="0,0,2,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewer:CompanyViewerUnitListItem">
                        <controls:CompanyViewerUnitTileView
                            ItemTappedCommand="{Binding SelectUnitCommand, Source={RelativeSource AncestorType={x:Type viewer:CompanyViewerViewModel}}, x:DataType=viewer:CompanyViewerViewModel}"
                            ItemTappedCommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" StrokeThickness="0" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatusMessage}"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center" />

                <VerticalStackLayout Grid.Row="1" Spacing="3" VerticalOptions="Center">
                    <!-- Readout eyebrow: class designation of the locked unit (LI / MI / HI / TAG / REM). -->
                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasSelectedUnitType}">
                        <BoxView WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                 BackgroundColor="{StaticResource Signal}" />
                        <Label Text="{Binding SelectedUnitType}"
                               Style="{StaticResource LabelCaption}"
                               TextColor="{StaticResource Signal}"
                               CharacterSpacing="3"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- The trooper's name; tap it or the pencil to rename. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsShowingName}">
                        <Label Text="{Binding SelectedName}" FontSize="{DynamicResource FontSizeDisplay}" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditNameCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <controls:SvgIcon Grid.Column="1"
                                          Style="{StaticResource NameActionIcon}"
                                          Source="SVGCache/NonCBIcons/noun-edit-333556.svg">
                            <controls:SvgIcon.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditNameCommand}" />
                            </controls:SvgIcon.GestureRecognizers>
                        </controls:SvgIcon>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsEditingName}">
                        <Entry Text="{Binding NameDraft}"
                               IsReadOnly="{Binding IsShowingName}"
                               FontSize="{DynamicResource FontSizeDisplay}">
                            <Entry.Behaviors>
                                <behaviors:FocusWhenEditableBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        <controls:SvgIcon Grid.Column="1"
                                          Style="{StaticResource NameActionIcon}"
                                          Source="SVGCache/NonCBIcons/noun-check-3612574.svg">
                            <controls:SvgIcon.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SaveNameCommand}" />
                            </controls:SvgIcon.GestureRecognizers>
                        </controls:SvgIcon>
                        <controls:SvgIcon Grid.Column="2"
                                          Style="{StaticResource NameActionIcon}"
                                          Source="SVGCache/NonCBIcons/noun-x-1890844.svg">
                            <controls:SvgIcon.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RejectNameCommand}" />
                            </controls:SvgIcon.GestureRecognizers>
                        </controls:SvgIcon>
                    </Grid>
                    <Label Text="{Binding SelectedBaseName}"
                           IsVisible="{Binding HasSelectedBaseName}"
                           FontSize="{DynamicResource FontSizeTitleSmall}"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Start" />
                </VerticalStackLayout>

                <controls:UnitDisplayConfigurationsView
                    Grid.Row="2"
                    SelectedUnitLogoSource="{Binding Detail.LogoSource}"
                    UnitNameHeading="{Binding Detail.UnitNameHeading}"
                    ShowRegularOrderIcon="{Binding Detail.ShowRegularOrderIcon}"
                    ShowIrregularOrderIcon="{Binding Detail.ShowIrregularOrderIcon}"
                    ShowImpetuousIcon="{Binding Detail.ShowImpetuousIcon}"
                    ShowTacticalAwarenessIcon="{Binding Detail.ShowTacticalAwarenessIcon}"
                    ShowCubeIcon="{Binding Detail.ShowCubeIcon}"
                    ShowCube2Icon="{Binding Detail.ShowCube2Icon}"
                    ShowHackableIcon="{Binding Detail.ShowHackableIcon}"
                    ShowLieutenantIcon="{Binding ShowLieutenantIcon}"
                    LieutenantIconCount="{Binding LieutenantIconCount}"
                    ShowPeripheralIcon="{Binding ShowPeripheralIcon}"
                    UnitHeaderPrimaryColor="{Binding HeaderColors.Primary}"
                    UnitHeaderSecondaryColor="{Binding HeaderColors.Secondary}"
                    UnitHeaderPrimaryTextColor="{Binding HeaderColors.PrimaryText}"
                    UnitHeaderSecondaryTextColor="{Binding HeaderColors.SecondaryText}"
                    UnitMov="{Binding Detail.UnitMov}"
                    UnitCc="{Binding Detail.UnitCc}"
                    UnitBs="{Binding Detail.UnitBs}"
                    UnitPh="{Binding Detail.UnitPh}"
                    UnitWip="{Binding Detail.UnitWip}"
                    UnitArm="{Binding Detail.UnitArm}"
                    UnitBts="{Binding Detail.UnitBts}"
                    UnitVitalityHeader="{Binding Detail.UnitVitalityHeader}"
                    UnitVitality="{Binding Detail.UnitVitality}"
                    UnitS="{Binding Detail.UnitS}"
                    UnitAva="{Binding Detail.UnitAva}"
                    ShowConfigurationsSection="False"
                    ShowSummaryRows="False"
                    EquipmentSummaryFormatted="{Binding Detail.EquipmentSummaryFormatted}"
                    SpecialSkillsSummaryFormatted="{Binding Detail.SpecialSkillsSummaryFormatted}" />

                <ScrollView Grid.Row="3">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <Label Text="WEAPONS"
                                   Style="{StaticResource LabelCaption}"
                                   TextColor="{StaticResource TextMuted}"
                                   CharacterSpacing="3"
                                   VerticalOptions="Center" />
                            <BoxView Grid.Column="1" HeightRequest="1" VerticalOptions="Center"
                                     BackgroundColor="{StaticResource Hairline}" />
                        </Grid>
                        <Label FormattedText="{Binding RangedWeaponsFormatted}" FontSize="{DynamicResource FontSizeBody}" LineBreakMode="WordWrap" />
                        <Label FormattedText="{Binding MeleeWeaponsFormatted}" FontSize="{DynamicResource FontSizeBody}" LineBreakMode="WordWrap" />
                        <Label FormattedText="{Binding PeripheralsFormatted}" FontSize="{DynamicResource FontSizeBody}" LineBreakMode="WordWrap" IsVisible="{Binding HasPeripherals}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>

</views:ContentPageBase>
