                Wrap="Wrap"
                AlignItems="Start"
                JustifyContent="Start">
                <FlexLayout.Resources>
                    <!-- Every entry takes the width the ViewModel works out: half the page, or its own width when narrow. -->
                    <Style TargetType="Grid">
                        <Setter Property="WidthRequest" Value="{Binding AttributionEntryWidth}" />
                        <Setter Property="FlexLayout.Grow" Value="0" />
                        <Setter Property="FlexLayout.Shrink" Value="0" />
                    </Style>
                </FlexLayout.Resources>
