<?xml version="1.0" encoding="utf-8" ?>
<baseViews:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:baseViews="clr-namespace:InfinityMercsApp.Views.Base"
             xmlns:viewModels="clr-namespace:InfinityMercsApp.ViewModels.About"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="InfinityMercsApp.Views.About.AboutPage"
             x:Name="Root"
             x:DataType="viewModels:AboutPageViewModel"
             Title="About">

    <ContentPage.Behaviors>
        <!-- Behaviors sit outside the visual tree, so the ViewModel is handed over explicitly. -->
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Root}, x:DataType=ContentPage}"
                                        EventName="SizeChanged"
                                        Command="{Binding FitAttributionColumnsCommand}"
                                        CommandParameter="{Binding Width, Source={x:Reference Root}, x:DataType=ContentPage}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label
                Text="InfinityMercsApp"
                FontSize="{DynamicResource FontSizeDisplay}"
                FontAttributes="Bold" />

            <Label
                Text="About this app"
                FontSize="{DynamicResource FontSizeSubHeadline}"
                FontAttributes="Bold" />

            <Label
                Text="Current Version: 0.1.0-alpha, 'Pano Was a Mistake'"
                LineBreakMode="WordWrap" />

            <Label
                Text="Authors"
                FontSize="{DynamicResource FontSizeSubHeadline}"
                FontAttributes="Bold"
                Margin="0,12,0,0" />

            <Label
                Text="Jeremiah Patrick"
                FontAttributes="Bold" />

            <Label
                Text="Email:" />

            <Label
                Text="jeremiahpatrick@protonmail.com"
                TextColor="#2563EB"
                TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenEmailCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                Text="Discord:" />

            <Label
                Text="edwardfredward_09529"
                TextColor="#2563EB"
                TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenDiscordCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label
                Text="Attribution"
                FontSize="{DynamicResource FontSizeSubHeadline}"
                FontAttributes="Bold"
                Margin="0,12,0,0" />

            <Label
