<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:items="clr-namespace:InfinityMercsApp.ViewModels.UnitBrowser.Items;assembly=InfinityMercsApp.ViewModels"
             x:Class="InfinityMercsApp.Views.Controls.UnitSelectionListItemView"
             x:DataType="items:IViewerListItem"
             x:Name="Root">

    <Border Padding="0" StrokeThickness="0" BackgroundColor="Transparent">
        <Border.Triggers>
            <!-- The TAG Company's own TAG stands out; the selected unit wins over that (the later trigger applies). -->
            <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted, Source={x:Reference Root}, x:DataType=controls:UnitSelectionListItemView}" Value="True">
                <Setter Property="BackgroundColor" Value="#800000FF" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="#334155" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ItemTappedCommand, Source={x:Reference Root}, x:DataType=controls:UnitSelectionListItemView}"
                                  CommandParameter="{Binding .}" />
        </Border.GestureRecognizers>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>

        <Grid
            Padding="8,6"
            MinimumHeightRequest="50"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="10">
            <controls:SvgIcon WidthRequest="32" HeightRequest="32" VerticalOptions="Center" Sources="{Binding LogoCandidates}" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label
                    Text="{Binding Name}"
                    TextColor="{StaticResource TextPrimary}" />
                <Label
                    Text="{Binding Subtitle}"
                    FontSize="{DynamicResource FontSizeCaption}"
                    TextColor="{StaticResource TextMuted}"
                    IsVisible="{Binding HasSubtitle}" />
            </VerticalStackLayout>
        </Grid>
    </Border>

</ContentView>
