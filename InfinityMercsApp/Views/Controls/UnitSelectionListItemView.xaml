<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             x:Class="InfinityMercsApp.Views.Controls.UnitSelectionListItemView">

    <Border x:Name="ItemBorder" Padding="0" StrokeThickness="0" BackgroundColor="{Binding UnitListBackgroundColor}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnItemTapped" />
        </Border.GestureRecognizers>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>

        <Grid
            Padding="8,6"
            MinimumHeightRequest="50"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="10">
            <controls:CachedSvgImage
                Item="{Binding .}"
                WidthRequest="32"
                HeightRequest="32"
                LogicalWidth="32"
                LogicalHeight="32"
                VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label
                    Text="{Binding Name}"
                    TextColor="{StaticResource TextPrimary}" />
                <Label
                    Text="{Binding Subtitle}"
                    FontSize="{DynamicResource FontSizeCaption}"
                    TextColor="{StaticResource TextMuted}"
                    IsVisible="{Binding HasSubtitle}" />
            </VerticalStackLayout>
        </Grid>
    </Border>

</ContentView>
