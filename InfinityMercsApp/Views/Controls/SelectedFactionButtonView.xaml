<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             x:Class="InfinityMercsApp.Views.Controls.SelectedFactionButtonView"
             x:Name="SelectedFactionButtonRoot"
             x:DataType="controls:SelectedFactionButtonView">

    <Border Stroke="{StaticResource Signal}"
            StrokeThickness="2"
            BackgroundColor="{StaticResource Plate}"
            Padding="10,8">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference SelectedFactionButtonRoot}}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
            <controls:SvgIcon
                Source="{Binding LeftSlotSource, Source={x:Reference SelectedFactionButtonRoot}}"
                WidthRequest="34"
                HeightRequest="34"
                VerticalOptions="Center" />
            <controls:SvgIcon
                Grid.Column="1"
                Source="{Binding RightSlotSource, Source={x:Reference SelectedFactionButtonRoot}}"
                WidthRequest="34"
                HeightRequest="34"
                VerticalOptions="Center"
                IsVisible="{Binding ShowRightSlot, Source={x:Reference SelectedFactionButtonRoot}}" />
            <Label
                Grid.Column="2"
                Text="{Binding PromptText, Source={x:Reference SelectedFactionButtonRoot}}"
                FontSize="{DynamicResource FontSizeBody}"
                TextColor="{StaticResource TextMuted}"
                LineBreakMode="TailTruncation"
                VerticalOptions="Center" />
            <Label
                Grid.Column="3"
                Text="CHANGE"
                FontSize="{DynamicResource FontSizeCaption}"
                FontAttributes="Bold"
                TextColor="{StaticResource Signal}"
                VerticalOptions="Center" />
        </Grid>
    </Border>

</ContentView>
