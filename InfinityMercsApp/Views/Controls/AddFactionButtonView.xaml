<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             x:Class="InfinityMercsApp.Views.Controls.AddFactionButtonView"
             x:Name="AddFactionButtonRoot"
             x:DataType="controls:AddFactionButtonView">
    <!-- A round button with a plus while the faction strip is closed and a minus while it is open. -->
    <Border Stroke="{StaticResource Signal}"
            StrokeThickness="2"
            WidthRequest="40"
            HeightRequest="40"
            Padding="6,4"
            BindingContext="{x:Reference AddFactionButtonRoot}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="999" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command}" />
        </Border.GestureRecognizers>
        <Grid WidthRequest="24" HeightRequest="24">
            <BoxView Color="#22C55E" WidthRequest="15" HeightRequest="4" CornerRadius="2" HorizontalOptions="Center" VerticalOptions="Center" />
            <BoxView Color="#22C55E" WidthRequest="4" HeightRequest="15" CornerRadius="2" HorizontalOptions="Center" VerticalOptions="Center"
                     IsVisible="{Binding IsExpanded, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>
    </Border>
</ContentView>
