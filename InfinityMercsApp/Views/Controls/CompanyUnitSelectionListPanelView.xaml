<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:selectionItems="clr-namespace:InfinityMercsApp.ViewModels.Company.Selection.Items;assembly=InfinityMercsApp.ViewModels"
             xmlns:behaviors="clr-namespace:InfinityMercsApp.Views.Behaviors"
             x:Class="InfinityMercsApp.Views.Controls.CompanyUnitSelectionListPanelView"
             x:Name="UnitSelectionPanelRoot">

    <Grid RowDefinitions="Auto,*" RowSpacing="8" VerticalOptions="Fill">
        <Grid Grid.Row="0" ColumnDefinitions="*" ColumnSpacing="10" VerticalOptions="Center">
            <!-- The filter button is kept a square 0.8 of the header's height. -->
            <controls:SquareScalingBorder
                x:Name="UnitSelectionHeaderBorder"
                Grid.Column="0"
                Padding="12,8,0,8"
                BackgroundColor="Black">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label
                        x:Name="UnitSelectionHeaderLabel"
                        Grid.Column="0"
                        Text="UNIT SELECTION"
                        FontSize="{DynamicResource FontSizeSectionHeader}"
                        FontAttributes="Bold"
                        TextColor="White"
                        LineBreakMode="WordWrap"
                        MaxLines="2"
                        HorizontalTextAlignment="Start"
                        VerticalTextAlignment="Center"
                        VerticalOptions="Center" />
                    <Border
                        x:Name="UnitSelectionFilterButton"
                        Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="0"
                        Margin="0,0,12,0"
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=FilterCommand, x:DataType=controls:CompanyUnitSelectionListPanelView}" />
                        </Border.GestureRecognizers>
                        <controls:SvgIcon
                            x:Name="UnitSelectionFilterIcon"
                            Source="SVGCache/NonCBIcons/noun-filter.svg"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill">
                            <controls:SvgIcon.Triggers>
                                <DataTrigger TargetType="controls:SvgIcon"
                                             Binding="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=IsFilterActive, x:DataType=controls:CompanyUnitSelectionListPanelView}"
                                             Value="True">
                                    <Setter Property="TintColor" Value="#B2FFDC00" />
                                </DataTrigger>
                            </controls:SvgIcon.Triggers>
                        </controls:SvgIcon>
                    </Border>
                </Grid>
            </controls:SquareScalingBorder>
        </Grid>

        <ScrollView
            Grid.Row="1"
            IsVisible="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=ShowUnitsList, x:DataType=controls:CompanyUnitSelectionListPanelView}">
            <ScrollView.Behaviors>
                <behaviors:DragToScrollBehavior />
            </ScrollView.Behaviors>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=ItemsSource, x:DataType=controls:CompanyUnitSelectionListPanelView}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="selectionItems:ArmyUnitSelectionItem">
                        <controls:UnitSelectionListItemView
                            ItemTappedCommand="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=ItemTappedCommand, x:DataType=controls:CompanyUnitSelectionListPanelView}"
                            IsHighlighted="{Binding UseBlueHalfOpacityBackground}"
                            IsVisible="{Binding IsVisible}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>
