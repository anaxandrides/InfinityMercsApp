<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             x:Class="InfinityMercsApp.Views.Controls.CompanyUnitSelectionListPanelView"
             x:Name="UnitSelectionPanelRoot">

    <Grid RowDefinitions="Auto,*" RowSpacing="8" VerticalOptions="FillAndExpand">
        <Grid Grid.Row="0" ColumnDefinitions="*" ColumnSpacing="10" VerticalOptions="Center">
            <Border
                x:Name="UnitSelectionHeaderBorder"
                Grid.Column="0"
                Padding="12,8,0,8"
                BackgroundColor="Black"
                SizeChanged="OnHeaderBorderSizeChanged">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label
                        x:Name="UnitSelectionHeaderLabel"
                        Grid.Column="0"
                        Text="UNIT SELECTION"
                        FontSize="{DynamicResource FontSizeSectionHeader}"
                        FontAttributes="Bold"
                        TextColor="White"
                        LineBreakMode="WordWrap"
                        MaxLines="2"
                        HorizontalTextAlignment="Start"
                        VerticalTextAlignment="Center"
                        VerticalOptions="Center" />
                    <Border
                        x:Name="UnitSelectionFilterButton"
                        Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="2"
                        Margin="0,0,12,0"
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=FilterCommand}" />
                        </Border.GestureRecognizers>
                        <controls:SvgIcon
                            x:Name="UnitSelectionFilterIcon"
                            Source="SVGCache/NonCBIcons/noun-filter.svg"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                            <controls:SvgIcon.Triggers>
                                <DataTrigger TargetType="controls:SvgIcon"
                                             Binding="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=IsFilterActive}"
                                             Value="True">
                                    <Setter Property="TintColor" Value="#B2FFDC00" />
                                </DataTrigger>
                            </controls:SvgIcon.Triggers>
                        </controls:SvgIcon>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <ScrollView
            x:Name="UnitSelectionScrollView"
            Grid.Row="1"
            IsVisible="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=ShowUnitsList}">
            <ScrollView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnUnitSelectionScrollPanUpdated" />
            </ScrollView.GestureRecognizers>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=ItemsSource}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <controls:UnitSelectionListItemView
                            ItemTappedCommand="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=ItemTappedCommand}"
                            ItemTappedCommandParameter="{Binding .}"
                            IsVisible="{Binding IsVisible}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>
