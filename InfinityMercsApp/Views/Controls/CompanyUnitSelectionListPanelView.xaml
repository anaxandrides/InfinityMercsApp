<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="InfinityMercsApp.Views.Controls.CompanyUnitSelectionListPanelView"
             x:Name="UnitSelectionPanelRoot">

    <Grid RowDefinitions="Auto,*" RowSpacing="8" VerticalOptions="FillAndExpand">
        <Grid Grid.Row="0" ColumnDefinitions="*" ColumnSpacing="10" VerticalOptions="Center">
            <Border
                x:Name="UnitSelectionHeaderBorder"
                Grid.Column="0"
                Padding="12,8,0,8"
                BackgroundColor="Black"
                SizeChanged="OnHeaderBorderSizeChanged">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label
                        x:Name="UnitSelectionHeaderLabel"
                        Grid.Column="0"
                        Text="UNIT SELECTION"
                        FontSize="{DynamicResource FontSizeSectionHeader}"
                        FontAttributes="Bold"
                        TextColor="White"
                        LineBreakMode="WordWrap"
                        MaxLines="2"
                        HorizontalTextAlignment="Start"
                        VerticalTextAlignment="Center"
                        VerticalOptions="Center" />
                    <Border
                        x:Name="UnitSelectionFilterButton"
                        Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="2"
                        Margin="0,0,12,0"
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterButtonTapped" />
                        </Border.GestureRecognizers>
                        <skia:SKCanvasView
                            x:Name="UnitSelectionFilterCanvas"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            PaintSurface="OnFilterCanvasPaintSurface" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- CollectionView virtualizes the unit list and scrolls natively; the ItemsSource binding
             sits on the CollectionView element (still in this control's namescope, so x:Reference
             resolves), while the per-item command uses RelativeSource since a DataTemplate is a
             separate namescope where x:Reference to the control root does not resolve. -->
        <CollectionView
            x:Name="UnitSelectionCollectionView"
            Grid.Row="1"
            IsVisible="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=ShowUnitsList}"
            ItemsSource="{Binding Source={x:Reference UnitSelectionPanelRoot}, Path=ItemsSource}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <controls:UnitSelectionListItemView
                        ItemTappedCommand="{Binding ItemTappedCommand, Source={RelativeSource AncestorType={x:Type controls:CompanyUnitSelectionListPanelView}}}"
                        ItemTappedCommandParameter="{Binding .}"
                        IsVisible="{Binding IsVisible}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
