<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InfinityMercsApp.Views.Controls.CachedSvgImage">

    <!-- Drop-in replacement for the old per-item logo SKCanvasView: a single native Image bound to
         a cached, pre-rasterized PNG. No live Skia surface, no per-widget SVG parse. -->
    <Image x:Name="InnerImage"
           Aspect="AspectFit"
           HorizontalOptions="Fill"
           VerticalOptions="Fill" />

</ContentView>
