<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             x:Class="InfinityMercsApp.Views.Controls.FactionListItemView"
             x:Name="FactionListItemRoot">

    <!-- Vertical tile: a centred logo above the faction name. The logo is a cached PNG rasterized
         once per (icon, size) and shown via a native Image (CachedSvgImage) instead of a live
         per-item Skia surface. Every call site uses this vertical tile. -->
    <Border x:Name="ItemBorder" Padding="0" StrokeThickness="0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnItemTapped" />
        </Border.GestureRecognizers>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource PlateRaised}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                <Setter Property="BackgroundColor" Value="Transparent" />
            </DataTrigger>
        </Border.Triggers>

        <Grid
            x:Name="VerticalLayoutRoot"
            Padding="8,6"
            MinimumHeightRequest="88"
            RowDefinitions="Auto,Auto"
            RowSpacing="6">
            <controls:CachedSvgImage
                Grid.Row="0"
                Item="{Binding .}"
                WidthRequest="48"
                HeightRequest="48"
                LogicalWidth="48"
                LogicalHeight="48"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <Grid Grid.Row="1">
                <Label
                    x:Name="VerticalNameLabel"
                    Text="{Binding Name}"
                    FontSize="{DynamicResource FontSizeBody}"
                    TextColor="{StaticResource TextPrimary}"
                    LineBreakMode="WordWrap"
                    MaxLines="3"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Fill" />
                <Label
                    x:Name="VerticalFormattedNameLabel"
                    FormattedText="{Binding Source={x:Reference FactionListItemRoot}, Path=TitleFormatted}"
                    FontSize="{DynamicResource FontSizeBody}"
                    TextColor="{StaticResource TextPrimary}"
                    LineBreakMode="WordWrap"
                    MaxLines="3"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Fill"
                    IsVisible="False" />
            </Grid>
        </Grid>
    </Border>

</ContentView>
