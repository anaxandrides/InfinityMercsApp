<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:selectionItems="clr-namespace:InfinityMercsApp.ViewModels.Company.Selection.Items;assembly=InfinityMercsApp.ViewModels"
             x:Class="InfinityMercsApp.Views.Controls.FactionListItemView"
             x:DataType="selectionItems:ArmyFactionSelectionItem"
             x:Name="FactionListItemRoot">

    <!-- A faction tile: its logo above its name. Chosen, it is raised, outlined in Signal green and ticked. -->
    <Border Padding="0" StrokeThickness="2" Stroke="Transparent">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ItemTappedCommand, Source={x:Reference FactionListItemRoot}, x:DataType=controls:FactionListItemView}"
                                  CommandParameter="{Binding .}" />
        </Border.GestureRecognizers>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource PlateRaised}" />
                <Setter Property="Stroke" Value="{StaticResource Signal}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                <Setter Property="BackgroundColor" Value="Transparent" />
            </DataTrigger>
        </Border.Triggers>

        <Grid Padding="8,6" MinimumHeightRequest="88" RowDefinitions="Auto,Auto" RowSpacing="6">
            <controls:SvgIcon Grid.Row="0" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" VerticalOptions="Center"
                              Sources="{Binding LogoCandidates}" />
            <Label Grid.Row="1"
                   Text="{Binding Name}"
                   FontSize="{DynamicResource FontSizeBody}"
                   TextColor="{StaticResource TextPrimary}"
                   LineBreakMode="WordWrap"
                   MaxLines="3"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Fill" />
            <Label Grid.Row="0"
                   Text="✓"
                   FontAttributes="Bold"
                   FontSize="{DynamicResource FontSizeSubHeadline}"
                   TextColor="{StaticResource Signal}"
                   HorizontalOptions="End"
                   VerticalOptions="Start"
                   IsVisible="{Binding IsSelected}" />
        </Grid>
    </Border>

</ContentView>
