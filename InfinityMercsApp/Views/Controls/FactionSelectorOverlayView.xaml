<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             x:Class="InfinityMercsApp.Views.Controls.FactionSelectorOverlayView"
             x:Name="FactionSelectorOverlayRoot"
             BackgroundColor="{StaticResource Void}"
             InputTransparent="False"
             IsVisible="{Binding Source={x:Reference FactionSelectorOverlayRoot}, Path=IsOpen}">

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="10">

        <!-- Header: title + close affordance -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label
                Grid.Column="0"
                Text="{Binding Source={x:Reference FactionSelectorOverlayRoot}, Path=Title}"
                FontSize="{DynamicResource FontSizeSubHeadline}"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                LineBreakMode="WordWrap"
                MaxLines="2"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                Stroke="{StaticResource Signal}"
                StrokeThickness="2"
                WidthRequest="36"
                HeightRequest="36"
                Padding="0"
                VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="&#x2715;"
                    FontSize="{DynamicResource FontSizeBody}"
                    TextColor="{StaticResource Signal}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Single column of full-width faction cards (Company-Style-Icon look), scrolling vertically.
             CollectionView virtualizes the (long) faction list. Two things that previously pushed this
             back to BindableLayout are handled explicitly: the per-item command uses RelativeSource
             (x:Reference does not resolve across a DataTemplate namescope), and ItemSizingStrategy is
             MeasureAllItems so WinUI measures each nested ContentView tile instead of collapsing it. -->
        <CollectionView Grid.Row="1"
                        ItemSizingStrategy="MeasureAllItems"
                        ItemsSource="{Binding Source={x:Reference FactionSelectorOverlayRoot}, Path=EffectiveItemsSource}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Stroke="{StaticResource Signal}"
                        StrokeThickness="2"
                        BackgroundColor="{StaticResource Plate}"
                        Padding="4"
                        Margin="0,0,0,8"
                        HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <controls:FactionListItemView
                            UseVerticalTileLayout="True"
                            ItemTappedCommand="{Binding ItemTappedCommand, Source={RelativeSource AncestorType={x:Type controls:FactionSelectorOverlayView}}}"
                            ItemTappedCommandParameter="{Binding .}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
