<?xml version="1.0" encoding="utf-8" ?>
<layout:AdaptiveContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:armory="clr-namespace:InfinityMercsApp.ViewModels.Armory"
             xmlns:controls="clr-namespace:InfinityMercsApp.Views.Controls"
             xmlns:layout="clr-namespace:InfinityMercsApp.Views.Adaptive"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:InfinityMercsApp.ViewModels"
             xmlns:domain="clr-namespace:InfinityMercsApp.Domain.Models.Metadata;assembly=InfinityMercsApp.Domain"
             x:Class="InfinityMercsApp.Views.ArmoryPage"
             x:Name="Root"
             x:DataType="armory:ArmoryViewModel"
             Title="Armory">

    <ContentPage.Behaviors>
        <!-- Behaviors sit outside the visual tree, so the ViewModel is handed over explicitly. -->
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Root}, x:DataType=ContentPage}"
                                        x:DataType="armory:ArmoryViewModel"
                                        EventName="LayoutModeChanged"
                                        Command="{Binding ApplyLayoutCommand}"
                                        CommandParameter="{Binding LayoutMode, Source={x:Reference Root}, x:DataType=layout:AdaptiveContentPage}" />
    </ContentPage.Behaviors>

    <Grid Padding="16" layout:GridLayout.Columns="{Binding Layout.Columns}" ColumnSpacing="{Binding Layout.ColumnSpacing}">

        <!-- Left: weapon list -->
        <Border IsVisible="{Binding IsListPaneVisible}" StrokeThickness="1" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Label Grid.Row="0"
                       Text="Weapons"
                       HorizontalTextAlignment="Center"
                       FontSize="{DynamicResource FontSizeTitleSmall}"
                       FontAttributes="Bold" />
                <Entry Grid.Row="1"
                       Placeholder="Search weapons..."
                       Text="{Binding SearchText}" />
                <CollectionView Grid.Row="2"
                                VerticalOptions="FillAndExpand"
                                ItemsSource="{Binding WeaponGroups}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedWeaponGroup, Mode=TwoWay}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="armory:WeaponGroup">
                            <Grid Padding="6,4">
                                <Label Text="{Binding Name}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Right: weapon detail -->
        <Border layout:GridLayout.Cell="{Binding Layout.DetailCell}" IsVisible="{Binding IsDetailPaneVisible}" StrokeThickness="1" Padding="14">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <!-- Compact-only return to the weapon list -->
                <Button
                        Grid.Row="0"
                        Text="← Weapons"
                        IsVisible="{Binding Layout.StacksPanes}"
                        HorizontalOptions="Start"
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        TextColor="{StaticResource Signal}"
                        FontAttributes="Bold"
                        Padding="0"
                        Command="{Binding CloseDetailCommand}" />
                <Label Grid.Row="1"
                       Text="{Binding SelectedWeaponName}"
                       FontSize="{DynamicResource FontSizeSubHeadline}"
                       FontAttributes="Bold" />
                <Grid Grid.Row="2">
                    <Label Text="Select a weapon from the list."
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="{StaticResource TextMuted}"
                           IsVisible="{Binding NoWeaponSelected}" />
                    <ScrollView VerticalOptions="Fill"
                                IsVisible="{Binding HasSelectedWeapon}">
                        <VerticalStackLayout MaximumWidthRequest="{Binding Layout.ReadingMaxWidth}"
                                             Spacing="8"
                                             BindableLayout.ItemsSource="{Binding SelectedWeaponGroup.Modes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="domain:Weapon">
                                    <controls:WeaponDetailCardView Weapon="{Binding}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Grid>
        </Border>

    </Grid>

</layout:AdaptiveContentPage>
