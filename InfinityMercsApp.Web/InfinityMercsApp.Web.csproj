<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.12" />
    <!-- Infrastructure's sqlite-net brings native SQLite, which the site never opens: its army data lives in memory
         (InMemoryRepository). Leaving the native library out keeps it from being linked into WebAssembly. -->
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.3" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfinityMercsApp.Domain\InfinityMercsApp.Domain.csproj" />
    <ProjectReference Include="..\InfinityMercsApp.ApiClient\InfinityMercsApp.ApiClient.csproj" />
    <ProjectReference Include="..\InfinityMercsApp.ViewModels\InfinityMercsApp.ViewModels.csproj" />
  </ItemGroup>

  <!-- The files the MAUI app bundles (MauiAsset in InfinityMercsApp.csproj) that the shared view models read: icons,
       stores and the glossary, served under package/ with the same paths. -->
  <ItemGroup>
    <PackageFile Include="..\InfinityMercsApp\Resources\Raw\**" PackagePath="%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageFile Include="..\InfinityMercsApp\Resources\Images\MercsIcons\**\*" PackagePath="MercsIcons/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageFile Include="..\InfinityMercsApp\SVGCache\CBIcons\**\*" PackagePath="SVGCache/CBIcons/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageFile Include="..\InfinityMercsApp\SVGCache\NonCBIcons\**\*" PackagePath="SVGCache/NonCBIcons/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageFile Include="..\InfinityMercsApp\SVGCache\MercsIcons\**\*" PackagePath="SVGCache/MercsIcons/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageFile Include="..\InfinityMercsApp\SVGCache\factions\1199.svg" PackagePath="SVGCache/factions/1199.svg" />
    <Content Include="@(PackageFile)" Link="wwwroot/package/$([System.String]::Copy('%(PackagePath)').Replace('\','/'))" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- package/files.txt lists them, so the site knows which exist without asking for each (WebPackageFiles). -->
  <Target Name="ListPackageFiles" BeforeTargets="AssignTargetPaths">
    <WriteLinesToFile File="$(IntermediateOutputPath)package-files.txt" Lines="@(PackageFile->'%(PackagePath)'->Replace('\','/'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)package-files.txt" Link="wwwroot/package/files.txt" CopyToOutputDirectory="Never" />
    </ItemGroup>
  </Target>

</Project>
