@inherits ObservingComponent
@using InfinityMercsApp.ViewModels.Company.Selection
@using InfinityMercsApp.ViewModels.Company.Selection.Items

@* The units the company can hire, or its fireteams with the troopers each allows. *@
<section class="pane units-pane" aria-label="Units">
    <div class="pane-tools">
        <button class="secondary small @(Screen.UnitList.IsFilterActive ? "active" : null)" @onclick="() => Screen.OpenUnitFilterCommand.Execute(null)">
            FILTER@(Screen.UnitList.IsFilterActive ? " · ON" : string.Empty)
        </button>
    </div>
    @if (Screen.UnitList.IsLoading)
    {
        <p class="muted">Loading the units…</p>
    }
    @if (Screen.UnitList.ShowUnitsList)
    {
        <div class="unit-list">
            @foreach (var unit in Screen.UnitList.Units)
            {
                <UnitRow @key="unit" Item="unit" Command="Screen.SelectUnitFromListCommand" IsHighlighted="unit.UseBlueHalfOpacityBackground" />
            }
        </div>
    }
    @if (Screen.UnitList.ShowTeamsList)
    {
        <p class="rule">@Screen.FireteamRuleText</p>
        @foreach (var team in Screen.UnitList.TeamEntries)
        {
            <TeamCard @key="team" Team="team" Screen="Screen" />
        }
    }
</section>

@if (Screen.UnitList.Filter is { } filter)
{
    <UnitFilterDialog Filter="filter" />
}

@code {
    [Parameter, EditorRequired] public required CompanySelectionViewModel Screen { get; set; }

    protected override void OnParametersSet()
    {
        StopWatching();
        Watch(Screen.UnitList);
        WatchItems(Screen.UnitList.Units);
        WatchItems(Screen.UnitList.TeamEntries);
    }
}
