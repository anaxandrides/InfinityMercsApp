@inherits ObservingComponent
@using InfinityMercsApp.ViewModels.Company.Selection
@using InfinityMercsApp.ViewModels.Company.Selection.Items

@if (Slot.IsVisible)
{
    <span class="count">@Slot.Min</span>
    <span class="count">@Slot.Max</span>
    <UnitRow Item="Slot" Command="Screen.SelectTeamAllowedProfileCommand" />
}

@code {
    [Parameter, EditorRequired] public required ArmyTeamUnitLimitItem Slot { get; set; }

    [Parameter, EditorRequired] public required CompanySelectionViewModel Screen { get; set; }

    protected override void OnParametersSet()
    {
        StopWatching();
        Watch(Slot);
    }
}
