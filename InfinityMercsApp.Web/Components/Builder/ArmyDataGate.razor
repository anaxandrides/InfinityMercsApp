@inherits ObservingComponent
@using InfinityMercsApp.Web.ArmyData
@inject WebArmyData ArmyData

@* Shows the page once the army data's metadata is in (a second or so); armies load as the page needs them. *@
@if (ArmyData.IsReady)
{
    @ChildContent
}
else if (ArmyData.FailureMessage.Length > 0)
{
    <section class="army-loading" role="alert">
        <h1>No army data</h1>
        <p>@ArmyData.FailureMessage</p>
    </section>
}
else
{
    <section class="army-loading" aria-live="polite">
        <p class="muted">Loading the army data…</p>
    </section>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Watch(ArmyData);
        _ = ArmyData.StartAsync();
    }
}
