@inherits ObservingComponent
@using InfinityMercsApp.ViewModels.Season.Game.Items

@* One XP box of a trooper's sheet. *@
<label class="xp-check">
    <input type="checkbox" checked="@Check.IsChecked" disabled="@(!Check.IsEnabled)" @onchange="e => Check.IsChecked = e.Value is true" />
    @Check.Label
</label>

@code {
    [Parameter, EditorRequired] public required XpCheck Check { get; set; }

    protected override void OnParametersSet()
    {
        StopWatching();
        Watch(Check);
    }
}
