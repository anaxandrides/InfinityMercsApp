@inherits ObservingComponent
@using InfinityMercsApp.ViewModels.Leagues

@* A company entered in a league, as its owner keeps it: read-only. *@
<p><a href="@WebRoutes.League(LeagueId)">← The league</a></p>
<h1>@ViewModel.Title</h1>

@if (ViewModel.Status.Length > 0)
{
    <p class="muted" role="status">@ViewModel.Status</p>
}

@if (ViewModel.Company is { } company)
{
    <p class="muted">@company.Type · @company.Armies · founded with @company.StartingPoints points</p>
    <ul class="troopers">
        @foreach (var trooper in company.Troopers)
        {
            <li class="trooper">
                <div class="heading">
                    <span class="title">@trooper.Name</span>
                    @if (!string.IsNullOrEmpty(trooper.Role))
                    {
                        <span class="tag">@trooper.Role</span>
                    }
                    <span class="cost">@trooper.Cost CR</span>
                </div>
                @if (trooper.Unit != trooper.Name)
                {
                    <div class="muted">@trooper.Unit</div>
                }
                <div class="attributes">@trooper.Attributes</div>
                <div class="muted">@trooper.Rank · @trooper.Experience XP</div>
            </li>
        }
    </ul>
}

@if (ViewModel.Season is { } season)
{
    <h2>Contracts</h2>
    @if (season.Contracts.Count == 0)
    {
        <p class="muted">No contracts played yet.</p>
    }
    else
    {
        <table class="contracts">
            <thead>
                <tr><th>Contract</th><th>Result</th><th class="number">OP</th><th class="number">Deployed</th><th class="number">XP</th></tr>
            </thead>
            <tbody>
                @foreach (var contract in season.Contracts)
                {
                    <tr>
                        <td>@contract.Number</td>
                        <td class="@contract.Result.ToLowerInvariant()">@contract.Result</td>
                        <td class="number">@contract.ObjectivePoints</td>
                        <td class="number">@contract.Deployed</td>
                        <td class="number">@contract.Experience</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (season.Retired.Count > 0)
    {
        <h2>Retired</h2>
        <p>@string.Join(", ", season.Retired)</p>
    }
}

@code {
    [Parameter, EditorRequired] public required LeagueCompanyViewModel ViewModel { get; set; }

    [Parameter, EditorRequired] public required string LeagueId { get; set; }

    [Parameter, EditorRequired] public required string SeasonId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        StopWatching();
        Watch(ViewModel);
        ViewModel.ApplyQueryAttributes(NavigationParameters.ForLeague(LeagueId, SeasonId));
        await ViewModel.InitializeAsyncCommand.ExecuteAsync(null);
    }
}
