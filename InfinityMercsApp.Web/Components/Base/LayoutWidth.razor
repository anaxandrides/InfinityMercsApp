@implements IAsyncDisposable
@using CommunityToolkit.Mvvm.Input
@using InfinityMercsApp.Presentation.Layouts
@inject IJSRuntime Js

@* Lays a view model out for the window's width, as the MAUI page does for its own (AdaptiveLayoutModes). *@

@code {
    private readonly string _id = Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private DotNetObjectReference<LayoutWidth>? _self;
    private AdaptiveLayoutMode? _mode;

    /// <summary>The view model's ApplyLayoutCommand.</summary>
    [Parameter, EditorRequired] public required IRelayCommand<AdaptiveLayoutMode> Apply { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/viewport.js");
        WidthChanged(await _module.InvokeAsync<double>("watch", _id, _self));
    }

    [JSInvokable]
    public void WidthChanged(double width)
    {
        var mode = AdaptiveLayoutModes.For(width);
        if (mode != _mode)
        {
            _mode = mode;
            Apply.Execute(mode);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unwatch", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is closing; there is nothing left to unwatch.
            }
        }

        _self?.Dispose();
    }
}
