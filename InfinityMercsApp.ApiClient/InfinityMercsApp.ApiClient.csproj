<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app's own API as its clients call it: the routes, the shapes sent and received, and an HTTP client. No
       storage or platform code, so the phone app, the API and the web app (in the browser) can all use it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
