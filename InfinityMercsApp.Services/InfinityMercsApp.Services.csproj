<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The phone app compiles ahead of time on iOS: flag anything that needs reflection or runtime code (JSON goes
         through source-generated contexts). Analysis only; it doesn't make the assembly trimmable. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_tempobj\\**\\*.cs" />
    <Compile Remove="_tempbuild\\**\\*.cs" />
    <Content Remove="_tempobj\\**\\*" />
    <Content Remove="_tempbuild\\**\\*" />
    <EmbeddedResource Remove="_tempobj\\**\\*" />
    <EmbeddedResource Remove="_tempbuild\\**\\*" />
    <None Remove="_tempobj\\**\\*" />
    <None Remove="_tempbuild\\**\\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfinityMercsApp" />
    <InternalsVisibleTo Include="InfinityMercsApp.ViewModels" />
    <InternalsVisibleTo Include="InfinityMercsApp.Web" />
    <InternalsVisibleTo Include="InfinityMercsApp.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfinityMercsApp.Domain\InfinityMercsApp.Domain.csproj" />
    <ProjectReference Include="..\InfinityMercsApp.Infrastructure\InfinityMercsApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
